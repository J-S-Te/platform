# 基础能力平台统一环境变量示例
# 此文件位于项目根目录，作为前后端与后续接入系统的公共配置模板。
# 复制为 .env 后按实际环境填写；不要提交 .env、私钥或任何真实密码。
# 前端 Vite 在 frontend/ 目录运行时，可将下方 VITE_* 项复制到 frontend/.env.local。

# ==================== 通用运行环境 ====================
# 运行环境：development、test 或 production；production 会启用更严格的 HTTPS 与安全校验。
APP_ENV=development
# 服务名称，用于日志、可观测性资源标识等。
APP_NAME=basic-platform
# 服务默认时区，使用 IANA 时区名称，例如 Asia/Shanghai。
APP_TIMEZONE=Asia/Shanghai

# ==================== 后端 HTTP（后端实现后启用） ====================
# 后端 HTTP 监听地址，":8080" 表示监听所有网卡的 8080 端口。
APP_HTTP_ADDR=:8080
# 对外访问的基础地址；生产环境必须使用 HTTPS，OIDC_ISSUER 留空时会复用此值。
APP_PUBLIC_BASE_URL=http://localhost:8080
# 允许访问 API 的浏览器来源；多个来源以英文逗号分隔。
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==================== MySQL（不使用 Redis） ====================
# MySQL 主机名或 IP 地址。
MYSQL_HOST=127.0.0.1
# MySQL 端口，默认 3306。
MYSQL_PORT=3306
# 应用使用的 MySQL 数据库名称。
MYSQL_DATABASE=basic_platform
# 应用连接 MySQL 使用的账号。
MYSQL_USERNAME=basic_platform
# 应用连接 MySQL 使用的密码；仅保存在本地或密钥管理系统中。
MYSQL_PASSWORD=
# MySQL DSN 附加参数；通常保留 charset、parseTime 与 loc 设置。
MYSQL_PARAMS="charset=utf8mb4&parseTime=true&loc=UTC"

# ==================== 控制台认证与会话 ====================
# JWT 使用密钥文件路径；请勿将私钥内容写入仓库。
# 本平台签发 JWT 的发行者（iss）声明。
AUTH_JWT_ISSUER=basic-platform
# 控制台访问令牌的受众（aud）声明。
AUTH_JWT_AUDIENCE=basic-platform-console
# 本地可通过 `make generate-dev-jwt-keys` 生成对应 Ed25519 PEM 文件。
# JWT Ed25519 私钥 PEM 文件路径；不可提交私钥文件。
AUTH_JWT_PRIVATE_KEY_PATH=./data/keys/jwt-ed25519-private.pem
# JWT Ed25519 公钥 PEM 文件路径。
AUTH_JWT_PUBLIC_KEY_PATH=./data/keys/jwt-ed25519-public.pem
# 浏览器会话 Cookie 名称。
AUTH_SESSION_COOKIE_NAME=bp_session
# 是否仅通过 HTTPS 发送会话 Cookie；生产环境必须设为 true。
AUTH_SESSION_COOKIE_SECURE=false
# Cookie SameSite 策略，可选 Strict、Lax 或 None。
AUTH_SESSION_COOKIE_SAME_SITE=Lax
# 登录会话有效期，例如 8h、30m。
AUTH_SESSION_TTL=8h
# OAuth 客户端回调地址策略：false 时仅允许 HTTPS，或 localhost/回环地址的 HTTP；
# 部署环境确需使用自定义 HTTP 回调时设为 true。生产环境建议保持 false 并使用 HTTPS。
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=true

# ==================== IAM 敏感字段保护（可选） ====================
# 提交 mobile 时需要 Base64 编码的 32 字节 AES-256 密钥；真实密钥仅保留在本地。
# 手机号字段的 AES-256 加密密钥，必须为 Base64 编码的 32 字节随机值。
IAM_MOBILE_ENCRYPTION_KEY=
# MFA、外部身份提供商 client_secret、外部 OIDC 登录 state 必须分别使用不同的 Base64 编码 32 字节 AES-256 密钥。
# 可通过 `openssl rand -base64 32` 分别生成；不得复用任意一项密钥。
# MFA 敏感信息的 AES-256 加密密钥；不得与其他 IAM 密钥复用。
IAM_MFA_ENCRYPTION_KEY=
# 外部身份提供商 client_secret 的 AES-256 加密密钥；不得复用。
IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY=
# 外部登录 state 参数的 AES-256 加密密钥；不得复用。
IAM_EXTERNAL_LOGIN_STATE_ENCRYPTION_KEY=

# ==================== 本地文件与日志 ====================
# 本地上传文件与任务附件的存储目录。
FILE_STORAGE_ROOT=./data/uploads
# 日志级别：debug、info、warn 或 error。
LOG_LEVEL=info
# 日志格式，推荐生产环境使用 json。
LOG_FORMAT=json
# 本地日志输出目录。
LOG_DIRECTORY=./data/logs

# ==================== 可观测性（可选，运行日志/Trace/Metric 不写入 MySQL） ====================
# 是否启用 OpenTelemetry Trace/Metric 导出。
OTEL_ENABLED=false
# OpenTelemetry 中显示的服务名称。
OTEL_SERVICE_NAME=basic-platform
# OTLP Collector 地址；未启用可留空。
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==================== 前端 Vite ====================
# 前端只可读取 VITE_ 前缀变量，敏感配置不得使用 VITE_ 前缀。
# 前端调用后端 API 的基础路径或地址。
VITE_API_BASE_URL=/api/v1
# 前端登录成功后的默认跳转路径。
VITE_LOGIN_SUCCESS_URL=/
