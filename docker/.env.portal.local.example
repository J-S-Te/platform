# 客户自助门户本地 Docker 环境模板。
# scripts/docker-local.sh 首次复制为 .env.portal.local，并生成数据库密码及三组互不复用的密钥。
# 浏览器 OIDC 和跨应用服务凭据由“应用接入”部署 Agent 一次性写入，禁止手工复用 CRM 凭据。

PORTAL_MYSQL_PASSWORD=REPLACE_WITH_GENERATED_PORTAL_PASSWORD
PORTAL_MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_PORTAL_ROOT_PASSWORD
PORTAL_MYSQL_DSN=portal:REPLACE_WITH_GENERATED_PORTAL_PASSWORD@tcp(portal-mysql:3306)/customer_portal?charset=utf8mb4&parseTime=true&loc=UTC&multiStatements=true

PORTAL_HTTP_ADDRESS=:8091
PORTAL_PATH_PREFIX=/customer-portal
PORTAL_PUBLIC_ORIGIN=http://localhost:8081

PORTAL_OIDC_ISSUER=http://localhost:8081
PORTAL_OIDC_BACKCHANNEL_BASE_URL=http://platform-api:8080
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_REDIRECT_URI=http://localhost:8081/customer-portal/auth/callback
PORTAL_OIDC_SCOPES=openid profile
PORTAL_OIDC_TENANT_ID=
PORTAL_ROLE_CONFIG_HASH=

PORTAL_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PORTAL_PLATFORM_BASE_URL=http://platform-api:8080
PORTAL_AUTHORIZATION_CATALOG_APPLICATION_ID=
PORTAL_AUTHORIZATION_CATALOG_CLIENT_ID=
PORTAL_AUTHORIZATION_CATALOG_CLIENT_SECRET=

PORTAL_ACCOUNT_SECURITY_CENTER_URL=http://localhost:8081/settings/security
PORTAL_SESSION_COOKIE_NAME=customer_portal_session
PORTAL_SESSION_COOKIE_SECURE=false
PORTAL_SESSION_TTL=15m

PORTAL_ENCRYPTION_KEY_BASE64=REPLACE_WITH_GENERATED_PORTAL_ENCRYPTION_KEY
PORTAL_REPORT_INGEST_DESCRIPTOR_KEY_BASE64=REPLACE_WITH_GENERATED_PORTAL_REPORT_DESCRIPTOR_KEY
PORTAL_HMAC_KEY_BASE64=REPLACE_WITH_GENERATED_PORTAL_HMAC_KEY

PORTAL_MACHINE_TOKEN_ISSUER=basic-platform
PORTAL_MACHINE_TOKEN_AUDIENCE=basic-platform-application
PORTAL_MACHINE_TOKEN_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
PORTAL_CRM_PROVISION_CLIENT_SUBJECT=
PORTAL_CRM_DISABLE_CLIENT_SUBJECT=
PORTAL_PROJECT_HISTORY_STALE_AFTER=10m

PORTAL_CRM_INVITE_BASE_URL=http://customer-api:8090/customer-opportunity/api/v1
PORTAL_CRM_INVITE_TOKEN_URL=http://platform-api:8080/oauth2/token
PORTAL_CRM_INVITE_CLIENT_ID=
PORTAL_CRM_INVITE_CLIENT_SECRET=
PORTAL_CRM_INVITE_SCOPE=portal.invite.verify
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
