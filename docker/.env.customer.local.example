# 客户与商机管理本地 Docker 环境模板。
# scripts/docker-local.sh 会复制为 .env.customer.local，并自动生成数据库密码和敏感字段密钥。
# 统一认证默认使用本地 Keycloak；CRM 不再支持本地开发认证绕过。
# Client Secret、租户 ID 由“应用接入”完成 Keycloak Client 创建后写入未提交的运行时文件。

CUSTOMER_MYSQL_PASSWORD=REPLACE_WITH_GENERATED_CUSTOMER_PASSWORD
CUSTOMER_MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_CUSTOMER_ROOT_PASSWORD

HTTP_ADDRESS=:8090
APP_PATH_PREFIX=/customer-opportunity
APP_PUBLIC_ORIGIN=http://localhost:8081
MYSQL_DSN=customer:REPLACE_WITH_GENERATED_CUSTOMER_PASSWORD@tcp(customer-mysql:3306)/customer_opportunity?charset=utf8mb4&parseTime=True&loc=UTC&multiStatements=true

DEV_AUTH_ENABLED=false
# 浏览器必须使用带 Realm 的公开 Issuer；容器发现/JWKS 请求走 Compose 私网后通道。
OIDC_ISSUER=http://localhost:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8081/customer-opportunity/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8081/customer-opportunity/
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=
OIDC_ROLE_CONFIG_HASH=
OIDC_MAX_EFFECTIVE_ROLES=3
OIDC_SESSION_COOKIE_NAME=customer_opportunity_session
OIDC_SESSION_TTL=15m
# 仅 localhost HTTP 开发环境可为 false；部署到 HTTPS 地址时必须设为 true。
OIDC_SESSION_COOKIE_SECURE=false

MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
MACHINE_TOKEN_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem

PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=

SENSITIVE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_GENERATED_CUSTOMER_ENCRYPTION_KEY
SENSITIVE_HMAC_KEY_BASE64=REPLACE_WITH_GENERATED_CUSTOMER_HMAC_KEY
PORTAL_INVITE_ENABLED=false
PLATFORM_EXTERNAL_IDENTITY_ENABLED=false
# 客户门户独立化（Phase 2 双写 → Phase 5 单写）：
# PORTAL_MAPPING_DUAL_WRITE=true      平台绑定与门户映射双写（过渡期，门户仍是权威）
# PORTAL_MAPPING_PLATFORM_ONLY=true   跳过门户映射调用，平台绑定成为唯一权威（需先开双写）
# PLATFORM_CUSTOMER_BINDING_BASE_URL  http://platform-api:8080/api/v1/internal/external-users
PORTAL_MAPPING_DUAL_WRITE=false
PORTAL_MAPPING_PLATFORM_ONLY=false
PLATFORM_CUSTOMER_BINDING_BASE_URL=

# 补偿 worker 平台绑定修复（与 PORTAL_MAPPING_DUAL_WRITE 同开；compose 已映射所需变量）
PORTAL_INVITE_COMPENSATION_BINDING_ENABLED=false
# portal-access-disable-worker 单写模式（Phase 5；该服务暂未进入 compose，接入时使用）
PORTAL_ACCESS_DISABLE_PLATFORM_ONLY=false
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_BASE_URL=
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_CLIENT_ID=
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_CLIENT_SECRET=
PORTAL_ACCESS_DISABLE_PLATFORM_BINDING_SCOPE=portal_mapping_disable

APPROVAL_TASK_RESOLVER_ENABLED=false
PORTAL_PROJECT_HISTORY_ENABLED=false
CONTRACT_VERIFICATION_ENABLED=false
CONTRACT_SUMMARY_URL=http://contract-api:8081/internal/contract-summary
CONTRACT_SUMMARY_TOKEN_URL=http://platform-api:8080/oauth2/token
CONTRACT_SUMMARY_CLIENT_ID=
CONTRACT_SUMMARY_CLIENT_SECRET=
CONTRACT_SUMMARY_SCOPE=contract.summary.read
CONTRACT_TOKEN_URL=http://platform-api:8080/oauth2/token
CONTRACT_OPPORTUNITY_INTAKE_URL=http://contract-api:8081/internal/opportunity-signed-events
CONTRACT_CLIENT_ID=
CONTRACT_CLIENT_SECRET=
CONTRACT_SCOPE=opportunity.signed.write
QB_STATUS_QUERY_ENABLED=false
QB_LAUNCH_ENABLED=false
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
