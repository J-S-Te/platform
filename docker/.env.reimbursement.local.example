# 模板仅列运行键，真实值经平台受控接入下发；不要把凭据提交到仓库。
HTTP_ADDRESS=:8087
MYSQL_DSN=
PUBLIC_BASE_URL=
PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_APPLICATION_CODE=reimbursement
PLATFORM_ENVIRONMENT_CODE=dev
PROJECT_API_BASE_URL=http://project-api:8082
FILE_GATEWAY_BASE_URL=http://file-gateway:8086
OIDC_ISSUER=
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_REDIRECT_URI=
OIDC_SESSION_ENCRYPTION_KEY_BASE64=
OIDC_SESSION_COOKIE_NAME=reimbursement_session
OIDC_SESSION_COOKIE_SECURE=true
CENTRAL_SESSION_ENABLED=true
REIMBURSEMENT_AUDIT_REQUIRED=true
PROJECT_REFERENCE_CLIENT_ID=
PROJECT_REFERENCE_CLIENT_SECRET=
PROJECT_SPEND_CLIENT_ID=
PROJECT_SPEND_CLIENT_SECRET=
FILE_GATEWAY_CLIENT_ID=
FILE_GATEWAY_CLIENT_SECRET=
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
PLATFORM_NOTIFICATION_CLIENT_ID=
PLATFORM_NOTIFICATION_CLIENT_SECRET=
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=
# 许可运行态材料由平台写入独立runtime/license-<service>.env，不在本模板伪造。

FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download
PLATFORM_OWNER_DIRECTORY_CLIENT_ID=
PLATFORM_OWNER_DIRECTORY_CLIENT_SECRET=
CENTRAL_SESSION_PUBLIC_BASE_URL=

# 通过本地受控初始化生成，不在模板提供业务库密码。
REIMBURSEMENT_MYSQL_PASSWORD=
REIMBURSEMENT_MYSQL_ROOT_PASSWORD=

# Dedicated cost reader stays closed until controlled identity delivery.

REIMBURSEMENT_COST_MACHINE_ENABLED=false
# 对应 JWT sub：OAuth client_id 标签。
REIMBURSEMENT_COST_MACHINE_CLIENT_ID=
# 对应 JWT oauth_client_id：注册记录 ID。
REIMBURSEMENT_COST_MACHINE_OAUTH_CLIENT_ID=
REIMBURSEMENT_COST_MACHINE_APPLICATION_ID=
REIMBURSEMENT_COST_MACHINE_ENVIRONMENT_ID=
REIMBURSEMENT_COST_MACHINE_CALLER_APPLICATION_CODE=settlement
REIMBURSEMENT_COST_MACHINE_CALLER_ENVIRONMENT_CODE=dev
REIMBURSEMENT_COST_MACHINE_TENANT_ID=
REIMBURSEMENT_COST_MACHINE_AUDIENCE=basic-platform-application
REIMBURSEMENT_COST_MACHINE_ISSUER=basic-platform
REIMBURSEMENT_COST_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
REIMBURSEMENT_COST_MACHINE_REQUIRED_SCOPE=reimbursement.cost_candidate.read
