# 由 scripts/prepare-docker-env.sh 于 2026-07-22 17:19:18 +0800 生成。
# 包含密码、加密密钥和首次初始化令牌，禁止提交或发送到不可信环境。
# ==================== 通用运行环境 ====================
# 运行环境：development、test 或 production；production 会启用更严格的 HTTPS 与安全校验。
APP_ENV=development
# 服务名称，用于日志、可观测性资源标识等。
APP_NAME=basic-platform
# 服务默认时区，使用 IANA 时区名称，例如 Asia/Shanghai。
APP_TIMEZONE=Asia/Shanghai
# 后端容器 HTTP 监听地址。
APP_HTTP_ADDR=:8080
# 经反向代理对用户公开的基础地址；生产环境必须使用 HTTPS。
APP_PUBLIC_BASE_URL=http://localhost:8081
# 允许访问 API 的浏览器来源；多个来源以英文逗号分隔。
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081

# ==================== MySQL ====================
# Compose 网络内 MySQL 服务名称或数据库主机地址。
MYSQL_HOST=mysql
# MySQL 端口。
MYSQL_PORT=3306
# 应用使用的 MySQL 数据库名称。
MYSQL_DATABASE=basic_platform
# 后端应用连接 MySQL 使用的账号。
MYSQL_USERNAME=basic_platform
# MySQL 容器首次初始化时创建的应用账号。
MYSQL_USER=basic_platform
# 应用 MySQL 密码；由准备脚本生成，不得提交或泄露。
MYSQL_PASSWORD=01d8cb17684ed395e9b5a633dcb99cdeb5064e01a9de23be
# MySQL root 密码；仅用于数据库初始化与维护，不得泄露。
MYSQL_ROOT_PASSWORD=d2d79dea7ebd36d845d9a8f580ea07ca36f7ede075d5cd8748c0665e84dc1cfe
# MySQL DSN 附加参数；通常保留 charset、parseTime 与 loc 设置。
MYSQL_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC

# ==================== 认证、会话与 OIDC ====================
# 本平台签发 JWT 的发行者（iss）声明。
AUTH_JWT_ISSUER=basic-platform
# 控制台/API 访问令牌的受众（aud）声明。
AUTH_JWT_AUDIENCE=basic-platform-api
# 接入系统令牌的受众（aud）声明。
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-application
# JWT Ed25519 私钥 PEM 在后端容器内的路径。
AUTH_JWT_PRIVATE_KEY_PATH=/app/data/keys/jwt-ed25519-private.pem
# JWT Ed25519 公钥 PEM 在后端容器内的路径。
AUTH_JWT_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
# 浏览器会话 Cookie 名称。
AUTH_SESSION_COOKIE_NAME=bp_session
# 是否仅通过 HTTPS 发送会话 Cookie；生产环境必须设为 true。
AUTH_SESSION_COOKIE_SECURE=false
# Cookie SameSite 策略，可选 Strict、Lax 或 None。
AUTH_SESSION_COOKIE_SAME_SITE=Lax
# 登录会话有效期，例如 8h、30m。
AUTH_SESSION_TTL=8h
# OAuth 客户端回调地址策略：false 时仅允许 HTTPS，或 localhost/回环地址的 HTTP；
# 部署环境确需使用自定义 HTTP 回调时设为 true。生产环境建议保持 false 并使用 HTTPS。
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=true

# OIDC 发行者地址；为空时使用 APP_PUBLIC_BASE_URL。
OIDC_ISSUER=http://localhost:8081

# ==================== IAM 敏感信息与外部登录 ====================
# 手机号字段的 Base64 编码 32 字节 AES-256 加密密钥。
IAM_MOBILE_ENCRYPTION_KEY=EK8BXVF/UZ6PAsFQELbZe123hSZxgQ5cFhDBA5mEKZk=
# MFA 敏感信息的独立 Base64 编码 32 字节 AES-256 加密密钥。
IAM_MFA_ENCRYPTION_KEY=9S4PprgFloM0HPxyBAmNN9ZNAeNi+S7w4V/FhWFd3jI=
# 外部身份提供商 client_secret 的独立 AES-256 加密密钥。
IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY=JnFRnoSysgqLP+r/nNrym1ZYnV7g81+oQcBLyqf+MiA=
# 外部登录 state 参数的独立 AES-256 加密密钥。
IAM_EXTERNAL_LOGIN_STATE_ENCRYPTION_KEY=xrVmfWXkijgYmSZoyoJ9iE7TmK2bmGz91FluqKeQId0=
# 外部 OIDC 提供商 HTTP 请求超时，必须大于 0 且不超过 1 分钟。
IAM_EXTERNAL_OIDC_HTTP_TIMEOUT=10s
# 钉钉 OAuth 接口单次 HTTP 请求超时，必须大于 0 且不超过 1 分钟。
IAM_DINGTALK_HTTP_TIMEOUT=10s
# 是否允许调用 HTTP 外部 OIDC 提供商；生产环境应保持 false。
IAM_EXTERNAL_OIDC_ALLOW_INSECURE_HTTP=false
# 外部 OIDC 白名单，填写精确 host 或 host:port，多个值以逗号分隔；留空表示不启用。
IAM_EXTERNAL_OIDC_ALLOWED_HOSTS=
# 首个超级管理员受控初始化令牌；至少 32 个随机字符，完成初始化后应清空并重启。
IAM_BOOTSTRAP_TOKEN=41e5cb427bde2f3542a9e305c038a9ff193894c7dfe41e1f6727be316e026d7b

# ==================== 审计、文件、异步任务与日志 ====================
# 服务端审计事件所属的平台应用编码，必须与注册表一致。
AUDIT_APPLICATION_CODE=platform
# 服务端审计事件所属的环境编码，必须与注册表一致。
AUDIT_ENVIRONMENT_CODE=dev
# 容器内上传文件与任务附件的存储目录。
FILE_STORAGE_ROOT=/app/data/uploads
# MySQL 异步任务 Worker 的唯一标识；多实例部署时必须不同。
ASYNC_WORKER_ID=basic-platform-worker-docker
# Worker 轮询任务的时间间隔。
ASYNC_WORKER_POLL_INTERVAL=2s
# Worker 判断任务锁已过期的超时时间。
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
# 日志级别：debug、info、warn 或 error。
LOG_LEVEL=info
# 日志格式，推荐生产环境使用 json。
LOG_FORMAT=json
# 容器内日志输出目录。
LOG_DIRECTORY=/app/data/logs
