# 本地 Docker Compose 环境模板。
# 使用 scripts/docker-local.sh up 首次启动时，会基于本文件生成 docker/.env.local，
# 自动替换数据库密码、外部敏感字段密钥和首次超级管理员初始化令牌。
# 不要提交 docker/.env.local，也不要把真实密码或密钥写回本模板。

APP_ENV=development
APP_NAME=basic-platform
APP_TIMEZONE=Asia/Shanghai
APP_HTTP_ADDR=:8080
APP_PUBLIC_BASE_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081

# MySQL 服务名为 mysql；该服务没有 ports 映射，只能通过 Compose 内网访问。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=basic_platform
MYSQL_USERNAME=basic_platform
# MYSQL_USER/MYSQL_ROOT_PASSWORD 由官方 MySQL 镜像读取，MYSQL_USERNAME 由后端读取。
MYSQL_USER=basic_platform
MYSQL_PASSWORD=bf0c7b8da2ad4f8974d77794644ddf3157ad9ce4c314857c
MYSQL_ROOT_PASSWORD=1d4e4dd360ad34e91b9259a8a65857f5505990b4259fc42164aa2bbce4b0e9de
MYSQL_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC

# 合同管理子系统 MySQL 密码；同时被 compose 里的 contract-mysql / temporal / contract-api 读取，
# 必须与 contract_management/.env.local 中的 CONTRACT_MYSQL_PASSWORD 保持一致。
CONTRACT_MYSQL_PASSWORD=44890b38a8ae473d82ee59b343cc9cd0dce1d31417b4eed61f0f6945f5e802a7
CONTRACT_MYSQL_ROOT_PASSWORD=6e90ea60451b0948b31306c00650a4e3a0eb1d4e1545775937966f7c066a094d

# subsystem-provisioner 启动 contract_management 后会自动调 sync-contract-catalog.sh
# 同步授权目录；这里给它准备好基础平台 MySQL 的连接信息（同一份 docker 网络）。
SUBSYSTEM_CATALOG_SYNC_ENABLED=true
SUBSYSTEM_CATALOG_SYNC_IMAGE=basic-platform/backend:local
SUBSYSTEM_CATALOG_SYNC_MYSQL_CONTAINER=basic-platform-local-mysql-1
SUBSYSTEM_CATALOG_SYNC_MYSQL_USER=basic_platform
SUBSYSTEM_CATALOG_SYNC_MYSQL_PASSWORD=bf0c7b8da2ad4f8974d77794644ddf3157ad9ce4c314857c
SUBSYSTEM_CATALOG_SYNC_MYSQL_DATABASE=basic_platform
SUBSYSTEM_CATALOG_SYNC_TARGET_APP_CODE=contract_management

# catalog-publisher 长期凭据：contract_management 的 subsystem-update 路径不会
# 重新签发该 client，因此从平台 env 注入（不是从 .env.local 读），让 API 容器和
# 部署助手都能拿到。首次 onboarding 时写进 contract_management/.env.local 后，
# 这两个值就是稳定常量。rotate 后需同时更新这里与 contract_management/.env.local。
CONTRACT_CATALOG_PUBLISHER_CLIENT_ID=contract_management-dev-catalog-publisher
CONTRACT_CATALOG_PUBLISHER_CLIENT_SECRET=ocsec_kxYxRaVAVewfodvDjJw9qqtQtYwEMbXey57Ff9rQVVE

AUTH_JWT_ISSUER=basic-platform
AUTH_JWT_AUDIENCE=basic-platform-api
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-application
# 留空时，后端按实际配置逻辑回退到 APP_PUBLIC_BASE_URL。
OIDC_ISSUER=http://localhost:8081
AUTH_JWT_PRIVATE_KEY_PATH=/app/data/keys/jwt-ed25519-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
AUTH_SESSION_COOKIE_NAME=bp_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=8h
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=true

# 当前后端配置实际读取的敏感字段保护密钥。
IAM_MOBILE_ENCRYPTION_KEY=9KPXz4C33Kw8LXq92R927WAvteAQE2b23BwdaBwk1UY=
IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY=kaEf1cpknc9vzKUeSSYmY4g3Z4khmn84NBZOP1jtEZ0=
IAM_EXTERNAL_LOGIN_STATE_ENCRYPTION_KEY=ekbCSaSugYC1QiiWMImNj3jznGxUaYS7TzLmdQ5vZDM=
IAM_EXTERNAL_OIDC_HTTP_TIMEOUT=10s
IAM_DINGTALK_HTTP_TIMEOUT=10s
IAM_EXTERNAL_OIDC_ALLOW_INSECURE_HTTP=false
IAM_EXTERNAL_OIDC_ALLOWED_HOSTS=
# 首次初始化命令需要；超级管理员初始化成功后可按需清空并重建 API/Worker。
IAM_BOOTSTRAP_TOKEN=3403b213930881e49bf0554cd3c88576f26aea75b495d8a5c5b3d2a892114e66

AUDIT_APPLICATION_CODE=platform
AUDIT_ENVIRONMENT_CODE=dev
FILE_STORAGE_ROOT=/app/data/uploads
ASYNC_WORKER_ID=basic-platform-worker-local
ASYNC_WORKER_POLL_INTERVAL=2s
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=/app/data/logs
KEYCLOAK_DB_PASSWORD=449a7a2d29bce85221a612f1449385f815813e48b3629eeb
KEYCLOAK_ADMIN_PASSWORD=9f5ed066d7ebf29839c53619fa4bc2928d8e6af47be8fa008f1a7d16c3d91d8f
KEYCLOAK_ADMIN_USERNAME=recovery-admin
KEYCLOAK_DB_ROOT_PASSWORD=12271060be2e9838996bb799604e0bd68aa2d65e4a3423a46d7e27eaa0260766
KEYCLOAK_MANAGEMENT_ENABLED=true
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:18090
KEYCLOAK_REALM=basic-platform
