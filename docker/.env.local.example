# 本地 Docker Compose 环境模板。
# 使用 scripts/docker-local.sh up 首次启动时，会基于本文件生成 docker/.env.local，
# 自动替换数据库密码、外部敏感字段密钥和首次超级管理员初始化令牌。
# 不要提交 docker/.env.local，也不要把真实密码或密钥写回本模板。

APP_ENV=development
APP_NAME=basic-platform
APP_TIMEZONE=Asia/Shanghai
APP_HTTP_ADDR=:8080
APP_PUBLIC_BASE_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081

# 可信反向代理：frontend 容器（nginx）在 Docker 网络内转发请求并携带 X-Forwarded-For。
# 必须包含 Docker 网段，否则审计与限流会把 frontend 容器/网关的内网 IP 当成客户端 IP。
APP_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# 仅控制 scripts/subsystem.sh 向平台管理 API 发送管理员口令/Cookie 时的传输保护。
# 默认只允许 HTTPS 或 localhost/回环 HTTP；可信局域网确需直接访问 HTTP API 时，
# 将开关设为 true，并在主机白名单中填写精确 IP/域名。不会限制 OAuth HTTP 回调地址。
BASIC_PLATFORM_ALLOW_INSECURE_HTTP_API=false
BASIC_PLATFORM_INSECURE_HTTP_API_ALLOWED_HOSTS=

# MySQL 服务名为 mysql；该服务没有 ports 映射，只能通过 Compose 内网访问。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=basic_platform
MYSQL_USERNAME=basic_platform
# MYSQL_USER/MYSQL_ROOT_PASSWORD 由官方 MySQL 镜像读取，MYSQL_USERNAME 由后端读取。
MYSQL_USER=basic_platform
MYSQL_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_ROOT_PASSWORD
MYSQL_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC

AUTH_JWT_ISSUER=basic-platform
AUTH_JWT_AUDIENCE=basic-platform-api
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-application
# 留空时，后端按实际配置逻辑回退到 APP_PUBLIC_BASE_URL。
OIDC_ISSUER=
AUTH_JWT_PRIVATE_KEY_PATH=/app/data/keys/jwt-ed25519-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
AUTH_SESSION_COOKIE_NAME=bp_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=8h
# Keycloak 灰度期间保留旧基础平台 Access Token；所有应用环境切换完成并清理旧会话后设为 false。
AUTH_LEGACY_PLATFORM_ACCESS_TOKEN_ENABLED=true
# 默认仅允许 HTTPS 或 localhost/回环 HTTP OAuth 回调。
# scripts/lan-access.sh enable 会在临时 LAN 覆盖文件中显式开启非回环 HTTP 回调；生产不要开启。
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=false

# 可选 Keycloak（仅 --profile keycloak 启动时使用）。密码只放在未提交的
# docker/.env.local 或本地 Secret 中；Keycloak 使用独立 MySQL 数据卷。
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_LOCAL_KEYCLOAK_DB_PASSWORD
KEYCLOAK_DB_ROOT_PASSWORD=REPLACE_WITH_LOCAL_KEYCLOAK_DB_ROOT_PASSWORD
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_HTTP_PORT=18090
# Keycloak is the standard OIDC edge for subsystem access. The platform creates
# its dedicated broker client on demand; browsers never receive these values.
KEYCLOAK_MANAGEMENT_ENABLED=true
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:18090
# Private Compose endpoint used only by Go OIDC backchannel requests. It must
# never be used as OIDC_ISSUER or exposed to browsers.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=basic-platform
# 本地 HTTP 调试保持 false；只在本地入口、回调地址和 Cookie 都迁移到 HTTPS 后再开启。
KEYCLOAK_REQUIRE_HTTPS=false
KEYCLOAK_PLATFORM_CLIENT_ID=
KEYCLOAK_PLATFORM_CLIENT_SECRET=

# 子系统新接入默认使用 Keycloak。已有环境不会被该值自动切换；请在基础平台
# “应用接入”中先同步 Keycloak 并通过门禁后再切换，必要时可回滚为 platform。
SUBSYSTEM_DEFAULT_ISSUER_ALIAS=keycloak

# 本地 CRM Token Claims 的目录基线。docker-local.sh 会在启动 CRM 前从当前
# 镜像读取实际目录哈希并重新校验；不要填入生产环境的策略哈希。
OIDC_ROLE_CONFIG_HASH=sha256:609436cbb09101c385c572ae41714202a83511b42cc675b7aa56e98d1dad536a

# 当前后端配置实际读取的敏感字段保护密钥。
IAM_MOBILE_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64_32_BYTE_KEY
IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64_32_BYTE_KEY
IAM_EXTERNAL_LOGIN_STATE_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64_32_BYTE_KEY
IAM_EXTERNAL_OIDC_HTTP_TIMEOUT=10s
IAM_DINGTALK_HTTP_TIMEOUT=10s
IAM_EXTERNAL_OIDC_ALLOW_INSECURE_HTTP=false
IAM_EXTERNAL_OIDC_ALLOWED_HOSTS=
# 首次初始化命令需要；超级管理员初始化成功后可按需清空并重建 API/Worker。
IAM_BOOTSTRAP_TOKEN=REPLACE_WITH_GENERATED_BOOTSTRAP_TOKEN
CUSTOMER_PORTAL_INITIAL_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPMENT_SECRET

AUDIT_APPLICATION_CODE=platform
AUDIT_ENVIRONMENT_CODE=dev
FILE_STORAGE_ROOT=/app/data/uploads
ASYNC_WORKER_ID=basic-platform-worker-local
ASYNC_WORKER_POLL_INTERVAL=2s
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=/app/data/logs
