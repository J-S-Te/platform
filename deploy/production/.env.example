# Compose 与主机入口
COMPOSE_PROJECT_NAME=basic-platform-production
# 必须是本部署目录在宿主机上的规范绝对路径；生产接入 Agent 以同路径挂载，
# 使 Docker Compose 的相对卷路径仍由宿主机正确解析。
SUBSYSTEM_PRODUCTION_HOST_DEPLOY_ROOT=/opt/basic-platform
# 迁移内置默认租户。单租户部署无需修改；多租户部署必须显式绑定一个生产租户。
SUBSYSTEM_PRODUCTION_ALLOWED_TENANT_ID=01J00000000000000000000000
# Agent 只读取该目录中随发布包审核的 YAML 接入清单。留空时自动使用
# <SUBSYSTEM_PRODUCTION_HOST_DEPLOY_ROOT>/subsystems.d；仅特殊目录布局才显式填写。
SUBSYSTEM_PRODUCTION_PROFILES_DIR=
FRONTEND_PORT=18082
FRONTEND_BIND_ADDRESS=127.0.0.1
PLATFORM_API_PORT=18080
CONTRACT_API_PORT=18081
CUSTOMER_API_PORT=18083
PORTAL_API_PORT=18084
APP_ENV=production
APP_NAME=basic-platform
APP_TIMEZONE=Asia/Shanghai
APP_HTTP_ADDR=:8080
APP_PUBLIC_BASE_URL=https://platform.example.com
APP_CORS_ALLOWED_ORIGINS=https://platform.example.com
APP_TRUSTED_PROXIES=172.16.0.0/12
# 生产接入脚本的管理员凭据只允许通过 HTTPS 或本机回环 API 发送。
BASIC_PLATFORM_ALLOW_INSECURE_HTTP_API=false
BASIC_PLATFORM_INSECURE_HTTP_API_ALLOWED_HOSTS=

# Platform MySQL
MYSQL_HOST=platform-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=basic_platform
MYSQL_USERNAME=basic_platform
MYSQL_USER=basic_platform
MYSQL_PASSWORD=REPLACE_WITH_PLATFORM_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_PLATFORM_MYSQL_ROOT_PASSWORD
MYSQL_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC

# Platform 认证、OIDC 与加密密钥
AUTH_JWT_ISSUER=basic-platform
AUTH_JWT_AUDIENCE=basic-platform-api
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-application
AUTH_JWT_PRIVATE_KEY_PATH=/app/data/keys/jwt-ed25519-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
AUTH_SESSION_COOKIE_NAME=bp_session
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=8h
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=false
OIDC_ISSUER=https://platform.example.com
IAM_MOBILE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
IAM_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS

# Platform 文件、Worker 与日志
AUDIT_APPLICATION_CODE=platform
AUDIT_ENVIRONMENT_CODE=prod
FILE_STORAGE_ROOT=/app/data/uploads
ASYNC_WORKER_ID=basic-platform-worker-production
ASYNC_WORKER_POLL_INTERVAL=2s
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=/app/data/logs

# Contract MySQL 与 Temporal
CONTRACT_MYSQL_PASSWORD=REPLACE_WITH_CONTRACT_MYSQL_PASSWORD
CONTRACT_MYSQL_ROOT_PASSWORD=REPLACE_WITH_CONTRACT_MYSQL_ROOT_PASSWORD
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_TLS=false

# 客户与商机 CRM / 客户 Portal 使用相互独立的数据库账号与 root 口令。
CUSTOMER_MYSQL_PASSWORD=REPLACE_WITH_CUSTOMER_MYSQL_PASSWORD
CUSTOMER_MYSQL_ROOT_PASSWORD=REPLACE_WITH_CUSTOMER_MYSQL_ROOT_PASSWORD
PORTAL_MYSQL_PASSWORD=REPLACE_WITH_PORTAL_MYSQL_PASSWORD
PORTAL_MYSQL_ROOT_PASSWORD=REPLACE_WITH_PORTAL_MYSQL_ROOT_PASSWORD

# 合同 OIDC、授权目录和审计凭据位于独立的 contract.env，不再注入基础平台容器。
