# Compose 与主机入口
COMPOSE_PROJECT_NAME=basic-platform-production
FRONTEND_PORT=18082
FRONTEND_BIND_ADDRESS=127.0.0.1
PLATFORM_API_PORT=18080
CONTRACT_API_PORT=18081
APP_ENV=production
APP_NAME=basic-platform
APP_TIMEZONE=Asia/Shanghai
APP_HTTP_ADDR=:8080
APP_PUBLIC_BASE_URL=https://platform.example.com
APP_CORS_ALLOWED_ORIGINS=https://platform.example.com
APP_TRUSTED_PROXIES=172.16.0.0/12

# Platform MySQL
MYSQL_HOST=platform-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=basic_platform
MYSQL_USERNAME=basic_platform
MYSQL_USER=basic_platform
MYSQL_PASSWORD=REPLACE_WITH_PLATFORM_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_PLATFORM_MYSQL_ROOT_PASSWORD
MYSQL_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC

# Platform 认证、OIDC 与加密密钥
AUTH_JWT_ISSUER=basic-platform
AUTH_JWT_AUDIENCE=basic-platform-api
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-application
AUTH_JWT_PRIVATE_KEY_PATH=/app/data/keys/jwt-ed25519-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
AUTH_SESSION_COOKIE_NAME=bp_session
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=8h
OIDC_ISSUER=https://platform.example.com
IAM_MOBILE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
IAM_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS

# Platform 文件、Worker 与日志
AUDIT_APPLICATION_CODE=platform
AUDIT_ENVIRONMENT_CODE=prod
FILE_STORAGE_ROOT=/app/data/uploads
ASYNC_WORKER_ID=basic-platform-worker-production
ASYNC_WORKER_POLL_INTERVAL=2s
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=/app/data/logs

# Contract MySQL 与 Temporal
CONTRACT_MYSQL_PASSWORD=REPLACE_WITH_CONTRACT_MYSQL_PASSWORD
CONTRACT_MYSQL_ROOT_PASSWORD=REPLACE_WITH_CONTRACT_MYSQL_ROOT_PASSWORD
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_TLS=false

# Contract OIDC：由 subsystem-onboarding.sh + 受控 provisioner 写入；此处仅展示运行时键名
PLATFORM_BASE_URL=http://platform-api:8080
OIDC_BACKCHANNEL_BASE_URL=http://platform-api:8080
OIDC_CLIENT_ID=REPLACE_WITH_CONTRACT_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_CONTRACT_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=https://platform.example.com/contract_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/contract_management/logged-out
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=REPLACE_WITH_PLATFORM_TENANT_ID
OIDC_SESSION_COOKIE_NAME=contract_management_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_TTL=8h
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
APP_PUBLIC_URL=https://platform.example.com/contract_management/
APP_PATH_PREFIX=/contract_management

# Contract 应用自有权限目录发布 Client，由平台应用管理创建，不能复用浏览器 Client。
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=REPLACE_WITH_CONTRACT_APPLICATION_ID
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=REPLACE_WITH_CONTRACT_CATALOG_CLIENT_ID
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=REPLACE_WITH_CONTRACT_CATALOG_CLIENT_SECRET

# Contract 审计机器客户端，不能复用浏览器 OIDC Client
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
PLATFORM_APPLICATION_CODE=contract_management
PLATFORM_ENVIRONMENT_CODE=prod
APPROVAL_NODE_TIMEOUT=72h
APPROVAL_REMINDER_INTERVAL=24h
ARCHIVE_CRON_SCHEDULE=0 16 * * *
APPROVER_ROLE_ASSIGNMENTS_JSON={}
