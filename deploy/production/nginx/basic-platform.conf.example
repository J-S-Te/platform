server {
    listen 80;
    server_name platform.example.com;
    # 不向客户端暴露 nginx 版本号（安全基线）。
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name platform.example.com;

    ssl_certificate /etc/letsencrypt/live/platform.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/platform.example.com/privkey.pem;

    # 隐藏 nginx 版本号；响应头安全基线（本 server 无 location 级 add_header，
    # server 级声明对所有代理响应生效）：禁止被第三方页面嵌入、拒绝 MIME 嗅探、
    # 不泄露来源 URL；CSP frame-ancestors 与 X-Frame-Options 双保险覆盖旧浏览器。
    server_tokens off;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    # 通用 50x 错误页：不回显上游/代理错误细节，只返回统一占位页。
    error_page 500 502 503 504 505 /50x.html;

    client_max_body_size 25m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location = /healthz {
        proxy_pass http://127.0.0.1:18080/healthz;
    }

    location = /readyz {
        proxy_pass http://127.0.0.1:18080/readyz;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:18080;
    }

    # 接入、更新、重试和下线会在受控 Agent 中串行执行备份、迁移与健康检查。
    # Agent 最长执行 15 分钟；外层代理额外保留 1 分钟传输余量，避免浏览器误判失败后重复接入。
    location ~ ^/api/v1/subsystem-(onboarding|update|retry|teardown)$ {
        proxy_connect_timeout 30s;
        proxy_send_timeout 960s;
        proxy_read_timeout 960s;
        proxy_pass http://127.0.0.1:18080;
    }

    location = /authorize {
        proxy_pass http://127.0.0.1:18080/authorize;
    }

    location = /.well-known/openid-configuration {
        proxy_pass http://127.0.0.1:18080/.well-known/openid-configuration;
    }

    location /oauth2/ {
        proxy_pass http://127.0.0.1:18080;
    }

    location = /contract_management/healthz {
        proxy_pass http://127.0.0.1:18081/healthz;
    }

    location /contract_management/auth/ {
        proxy_set_header X-Forwarded-Prefix /contract_management;
        proxy_pass http://127.0.0.1:18081/auth/;
    }

    location = /contract_management/logged-out {
        proxy_set_header X-Forwarded-Prefix /contract_management;
        proxy_pass http://127.0.0.1:18081/logged-out;
    }

    location /contract_management/api/ {
        proxy_set_header X-Forwarded-Prefix /contract_management;
        proxy_pass http://127.0.0.1:18081/api/;
    }

    location = /contract_management {
        return 308 /contract_management/;
    }

    location /contract_management/ {
        proxy_pass http://127.0.0.1:18082;
    }

    location = /project_management/healthz {
        proxy_pass http://127.0.0.1:18085/healthz;
    }

    location /project_management/auth/ {
        proxy_set_header X-Forwarded-Prefix /project_management;
        proxy_pass http://127.0.0.1:18085/auth/;
    }

    location = /project_management/logged-out {
        proxy_set_header X-Forwarded-Prefix /project_management;
        proxy_pass http://127.0.0.1:18085/logged-out;
    }

    location /project_management/api/ {
        proxy_set_header X-Forwarded-Prefix /project_management;
        proxy_pass http://127.0.0.1:18085/api/;
    }

    location = /project_management {
        return 308 /project_management/;
    }

    location /project_management/ {
        proxy_pass http://127.0.0.1:18082;
    }

    location = /customer-opportunity/healthz {
        proxy_pass http://127.0.0.1:18083/customer-opportunity/healthz;
    }

    location /customer-opportunity/auth/ {
        proxy_pass http://127.0.0.1:18083/customer-opportunity/auth/;
    }

    location /customer-opportunity/api/ {
        proxy_pass http://127.0.0.1:18083/customer-opportunity/api/;
    }

    location = /customer-opportunity {
        return 308 /customer-opportunity/;
    }

    location /customer-opportunity/ {
        proxy_pass http://127.0.0.1:18082;
    }

    location = /customer-portal/healthz {
        proxy_pass http://127.0.0.1:18084/customer-portal/healthz;
    }

    location /customer-portal/auth/ {
        proxy_pass http://127.0.0.1:18084/customer-portal/auth/;
    }

    location /customer-portal/api/ {
        proxy_pass http://127.0.0.1:18084/customer-portal/api/;
    }

    location = /customer-portal {
        return 308 /customer-portal/;
    }

    location /customer-portal/ {
        proxy_pass http://127.0.0.1:18082;
    }

    # 数据看板与统计分析：dashboard-api 路由原生保留 /data_analysis 前缀
    # （同 customer-opportunity 模式，不做 rewrite）；Vue 页面由统一前端承载。
    location = /data_analysis/healthz {
        proxy_pass http://127.0.0.1:18086/data_analysis/healthz;
    }

    location = /data_analysis/readyz {
        proxy_pass http://127.0.0.1:18086/data_analysis/readyz;
    }

    location /data_analysis/auth/ {
        proxy_pass http://127.0.0.1:18086/data_analysis/auth/;
    }

    location /data_analysis/api/ {
        proxy_pass http://127.0.0.1:18086/data_analysis/api/;
    }

    location = /data_analysis {
        return 308 /data_analysis/;
    }

    location /data_analysis/ {
        proxy_pass http://127.0.0.1:18082;
    }

    location / {
        proxy_pass http://127.0.0.1:18082;
    }

    # 通用错误页根路径；50x.html 放置于 nginx 静态目录（示例见下方注释）。
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
