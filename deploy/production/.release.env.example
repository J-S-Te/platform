# 首次初始化可先使用 main；第一次 CI 发布后会自动替换为不可变 digest。
FRONTEND_IMAGE=ghcr.io/j-s-te/frontend:main
PLATFORM_IMAGE=ghcr.io/j-s-te/platform:main
FILE_GATEWAY_IMAGE=ghcr.io/j-s-te/platform-file-gateway:main
# 为空时使用 Compose 的固定在线来源；离线导入 common 后写入本机不可变引用。
DOCKER_SOCKET_PROXY_IMAGE=
CONTRACT_IMAGE=ghcr.io/j-s-te/contract_management:main
CUSTOMER_CRM_IMAGE=ghcr.io/j-s-te/customer_and_opportunity:crm-main
CUSTOMER_PRESALE_TEMPORAL_WORKER_BUILD_ID=
CUSTOMER_PORTAL_IMAGE=ghcr.io/j-s-te/customer_and_opportunity:portal-main
PROJECT_IMAGE=ghcr.io/j-s-te/project_management:main
# 由不可变PROJECT_IMAGE摘要派生，与镜像指针在同一事务提交和回退。
PROJECT_BACKGROUND_BUILD_ID=
SETTLEMENT_IMAGE=ghcr.io/j-s-te/settlement:main
DATA_ANALYSIS_DASHBOARD_API_IMAGE=ghcr.io/j-s-te/data_analysis:dashboard-api-main
DATA_ANALYSIS_AGGREGATION_WORKER_IMAGE=ghcr.io/j-s-te/data_analysis:aggregation-worker-main
DATA_ANALYSIS_ALERT_WORKER_IMAGE=ghcr.io/j-s-te/data_analysis:alert-worker-main
DATA_ANALYSIS_MIGRATE_IMAGE=ghcr.io/j-s-te/data_analysis:production-migrate-main
