# 项目管理运行时专用配置。该文件只注入 project-api/project-migrate，禁止放入平台
# 数据库口令、IAM Bootstrap Token、手机号加密密钥等基础平台秘密。
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_IDP_HINT=basic-platform
OIDC_REDIRECT_URI=https://platform.example.com/project_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/project_management/logged-out
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=project_management_session
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_TTL=15m
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
APP_PATH_PREFIX=/project_management

PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_APPLICATION_CODE=project_management
PLATFORM_ENVIRONMENT_CODE=prod

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=project-management
TEMPORAL_TLS=false

# 合同系统内部接收接口默认关闭；启用时 CONTRACT_INTEGRATION_REQUIRE_BEARER 必须为 true。
# 关闭时两者都必须为 false，否则 project-api 启动配置校验会失败。
CONTRACT_INTEGRATION_ENABLED=false
CONTRACT_INTEGRATION_REQUIRE_BEARER=false
