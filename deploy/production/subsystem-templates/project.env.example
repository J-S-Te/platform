# 项目管理运行时专用配置。该文件只注入 project-api/project-migrate，禁止放入平台
# 数据库口令、IAM Bootstrap Token、手机号加密密钥等基础平台秘密。
# 许可运行态键（COMMERCIAL_LICENSE_ENABLED / COMMERCIAL_LICENSE_COMPATIBILITY）不在本模板：
# 由平台写入 runtime/license-<service>.env；兼容放行开关生产必须缺省（缺省即 fail-closed）。
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=PENDING_ONBOARDING
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_IDP_HINT=basic-platform
OIDC_REDIRECT_URI=https://platform.example.com/project_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/project_management/logged-out
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=project_management_session
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
OIDC_SESSION_COOKIE_SECURE=true
# 浏览器会话双期限：空闲 30 分钟（真实用户操作续期）+ 绝对上限 8 小时。
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
APP_PATH_PREFIX=/project_management

PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_APPLICATION_CODE=project_management
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUDIT_REQUIRED=true
# 审计 outbox「已投递行」本地清理（显式登记，生产默认关闭）：0=关闭清理，正整数=保留天数。
# 删除的是仅保存在本地的已投递审计证据，开启前必须完成保留期审批，且保留期不得短于审计要求；
# 各子系统代码缺省值曾不一致（合同侧曾默认 30 天清理），生产必须显式写 0，不能留空依赖缺省。
AUDIT_OUTBOX_DELIVERED_RETENTION_DAYS=0

# 服务项操作台从基础平台负责人目录选择团队负责人/项目经理/工程师。
# 与生产清单同值（true）：项目的负责人/工程师选择依赖只读负责人目录。
# 开启后 project_management 启动期要求 PLATFORM_OWNER_DIRECTORY_URL、
# PLATFORM_OWNER_DIRECTORY_CLIENT_ID/SECRET 非空且非占位（PENDING/CHANGEME/EXAMPLE.COM
# 一律拒绝），缺凭据即启动失败关闭，不会以空目录降级。
OWNER_DIRECTORY_ENABLED=true
PLATFORM_OWNER_DIRECTORY_URL=http://platform-api:8080/api/v1/internal/owner-directory
PLATFORM_OWNER_DIRECTORY_SCOPE=owner_directory.read
PLATFORM_OWNER_DIRECTORY_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_OWNER_DIRECTORY_CLIENT_SECRET=PENDING_ONBOARDING

FILE_GATEWAY_BASE_URL=http://file-gateway:8086
FILE_GATEWAY_ENABLED=true
FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download

# 站内信通知（notification.ingest）：URL/scope 与生产清单同值；
# PLATFORM_NOTIFICATION_CLIENT_ID/SECRET 由受控接入注入。
NOTIFICATION_ENABLED=true
PLATFORM_NOTIFICATION_URL=http://platform-api:8080/api/v1/notifications/events
PLATFORM_NOTIFICATION_SCOPE=notification.ingest
PLATFORM_NOTIFICATION_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_NOTIFICATION_CLIENT_SECRET=PENDING_ONBOARDING

# 立项/拆解前校验合同已审批（contract.approved.internal.read）。调用方固定为
# contract_management 应用，只接受绑定当前环境的最小权限机器令牌。
CONTRACT_APPROVAL_VALIDATION_ENABLED=true
# 显式开放本地委托建项；默认false保留已有审批合同来源。
# 原生来源不能自动转换成合同来源，后续补充协议/合同结算引用不适用。
PROJECT_NATIVE_ENABLED=false
CONTRACT_APPROVAL_VALIDATION_URL=http://contract-api:8081/internal/v1/project/approved-contracts
CONTRACT_APPROVAL_VALIDATION_SCOPE=contract.approved.internal.read
CONTRACT_APPROVAL_VALIDATION_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_APPROVAL_VALIDATION_CLIENT_SECRET=PENDING_ONBOARDING

# 数析看板读取项目明细（dashboard.project.read）。调用方固定为 data_analysis 应用，
# 只接受绑定当前环境的最小权限机器令牌；与生产清单同值。
DASHBOARD_MACHINE_ENABLED=true
DASHBOARD_MACHINE_REQUIRE_BEARER=true
DASHBOARD_MACHINE_ISSUER=basic-platform
DASHBOARD_MACHINE_AUDIENCE=basic-platform-application
DASHBOARD_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
DASHBOARD_MACHINE_CLIENT_ID=data_analysis-prod-project-dashboard
DASHBOARD_MACHINE_CALLER_APPLICATION_CODE=data_analysis
DASHBOARD_MACHINE_CALLER_ENVIRONMENT_CODE=prod
DASHBOARD_MACHINE_REQUIRED_SCOPE=dashboard.project.read

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=project-management
TEMPORAL_TLS=false

# 合同生效投递与检测类别目录读取使用同一受控机器边界。
CONTRACT_INTEGRATION_ENABLED=true
CONTRACT_INTEGRATION_REQUIRE_BEARER=true
CONTRACT_INTEGRATION_CLIENT_ID=contract_management-prod-project-integration
CONTRACT_INTEGRATION_AUDIENCE=basic-platform-application
CONTRACT_INTEGRATION_ISSUER=basic-platform
CONTRACT_INTEGRATION_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
CONTRACT_INTEGRATION_CALLER_APPLICATION_CODE=contract_management
CONTRACT_INTEGRATION_CALLER_ENVIRONMENT_CODE=prod
CONTRACT_INTEGRATION_REQUIRED_SCOPE=project.contract.import
MYSQL_DSN=project:${PROJECT_MYSQL_PASSWORD}@tcp(project-mysql:3306)/project_management?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# 后台调度：新部署显式使用Temporal，旧运行文件缺省仍走legacy兼容路径。
PROJECT_RUN_WORKER_WITH_API=false
PROJECT_BACKGROUND_ENGINE=temporal
PROJECT_BACKGROUND_TASK_QUEUE=project-management-background-v1
PROJECT_BACKGROUND_DEPLOYMENT_NAME=project-management-background
# Build由发布指针的完整不可变镜像摘要派生；禁止手填latest/pending。
PROJECT_BACKGROUND_BUILD_ID=
PROJECT_BACKGROUND_HEALTH_ADDRESS=127.0.0.1:9093
PROJECT_BACKGROUND_CONTROL_SOCKET=/tmp/project-background/control.sock
PROJECT_BACKGROUND_MAX_ITEMS=50
PROJECT_BACKGROUND_RUN_BUDGET=4m
PROJECT_BACKGROUND_ACTIVITY_TIMEOUT=55s
PROJECT_BACKGROUND_SLA_ACTIVITY_TIMEOUT=2m
PROJECT_BACKGROUND_WORKFLOW_RUN_TIMEOUT=6m
SLA_SCAN_INTERVAL=15m
NOTIFICATION_DISPATCH_INTERVAL=15s
# 完整项目投影的保护上限，只允许调低；批大小固定200。
PROJECT_SNAPSHOT_MAX_PROJECTS=50000
PROJECT_SNAPSHOT_MAX_SERVICE_ITEMS=250000
PROJECT_SNAPSHOT_MAX_BYTES=67108864
PROJECT_SNAPSHOT_MAX_LINE_BYTES=65536
PROJECT_SNAPSHOT_TIMEOUT=30s

# 结算项目引用只读入口：项目只校验平台签发的 Application JWT（issuer/audience/应用/环境/
# scope/公钥），不固定结算 client_id；ALLOW_ANY_CLIENT=true 时 CLIENT_ID 留空，
# 结算与项目任一方先接入都可运行。设为 false 时必须填写精确的结算 client_id。
SETTLEMENT_REFERENCE_ENABLED=true
SETTLEMENT_REFERENCE_ALLOW_ANY_CLIENT=true
SETTLEMENT_REFERENCE_CLIENT_ID=
SETTLEMENT_REFERENCE_AUDIENCE=basic-platform-application
SETTLEMENT_REFERENCE_ISSUER=basic-platform
SETTLEMENT_REFERENCE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
SETTLEMENT_REFERENCE_CALLER_ENVIRONMENT_CODE=prod

# 人员离职交接入站（/internal/v1/handover/*）。平台按批次租户自签短效 application JWT
# （platform-handover / scope handover.machine / 调用方应用 platform），项目侧只用平台
# Ed25519 公钥验签；租户只来自令牌。开关与生产清单一致（true）。
# CALLER_APPLICATION_CODE 必须是平台应用编码 platform，不能沿用历史默认 basic-platform。
HANDOVER_INTEGRATION_ENABLED=true
HANDOVER_INTEGRATION_CLIENT_ID=platform-handover
HANDOVER_INTEGRATION_AUDIENCE=basic-platform-application
HANDOVER_INTEGRATION_ISSUER=basic-platform
HANDOVER_INTEGRATION_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
HANDOVER_INTEGRATION_CALLER_APPLICATION_CODE=platform
HANDOVER_INTEGRATION_CALLER_ENVIRONMENT_CODE=prod
HANDOVER_INTEGRATION_REQUIRED_SCOPE=handover.machine

# 历史导入采用独立确认与最小权限机器身份；新增默认关闭。
# 完整接入组由受控登记流程填入，不能复用普通统计或项目的凭据。
PROJECT_CONTRACT_IMPORT_ENABLED=false
PROJECT_CONTRACT_IMPORT_CLIENT_ID=
PROJECT_CONTRACT_IMPORT_AUDIENCE=
PROJECT_CONTRACT_IMPORT_ISSUER=
PROJECT_CONTRACT_IMPORT_PUBLIC_KEY_PATH=
PROJECT_CONTRACT_IMPORT_CALLER_ENVIRONMENT_CODE=

# 现场签到：服务项带 site_code 时按站点坐标做球面距离校验。
# 超距/站点缺失/无坐标/停用按策略要求填写偏离原因；无 site_code 的历史项保持可签到。
PROJECT_FIELD_CHECKIN_DISTANCE_METERS=1000
PROJECT_FIELD_CHECKIN_SITE_MISSING_POLICY=REQUIRE_REASON

# 由受控接入写入中央会话开关与本应用外部入口，正式值以平台登记为准。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=PENDING_ONBOARDING
# 中央会话只读缓存（显式登记，生产默认关闭）：单位毫秒，0=关闭，上限 5000。
# 开启后平台侧撤销/登出的本地生效延迟 ≤ 该值，须确认业务可接受吊销延迟后才开启；
# 超过上限按 5000 处理，非法值回退代码缺省 2000。
CENTRAL_SESSION_CACHE_MS=0
