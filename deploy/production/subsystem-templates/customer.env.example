# CRM 独立运行配置。复制到 runtime/customer.env，权限必须为 0600。
HTTP_ADDRESS=:8090
APP_PATH_PREFIX=/customer-opportunity
APP_PUBLIC_ORIGIN=https://platform.example.com
DEV_AUTH_ENABLED=false

OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=https://platform.example.com/customer-opportunity/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/customer-opportunity/
OIDC_SCOPES=openid profile
OIDC_IDP_HINT=basic-platform
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_ROLE_CONFIG_HASH=PENDING_ONBOARDING
OIDC_MAX_EFFECTIVE_ROLES=10
OIDC_SESSION_COOKIE_NAME=customer_opportunity_session
OIDC_SESSION_TTL=15m
OIDC_SESSION_COOKIE_SECURE=true
# 仅无 HTTPS 的测试服务器可显式设为 true；生产必须保持 false/默认并使用 HTTPS。
OIDC_ALLOW_INSECURE_HTTP_SESSION=false

MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
MACHINE_TOKEN_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem

PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING

PLATFORM_APPLICATION_CODE=customer_and_opportunity
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_WORKER_ID=crm-api-audit
PLATFORM_AUDIT_POLL_INTERVAL=1s
PLATFORM_AUDIT_BATCH_SIZE=100

# 站内信双写平台机器凭据（notification.ingest，由“一键接入”下发）。
PLATFORM_NOTIFICATION_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_NOTIFICATION_CLIENT_SECRET=PENDING_ONBOARDING
NOTIFICATION_DELIVERY_WORKER_ID=crm-notification-delivery-worker-1
NOTIFICATION_DELIVERY_POLL_INTERVAL=5s
NOTIFICATION_DELIVERY_BATCH_SIZE=100

SENSITIVE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
SENSITIVE_HMAC_KEY_BASE64=REPLACE_WITH_AT_LEAST_32_BYTE_BASE64_KEY
PORTAL_INVITE_PEPPER_BASE64=REPLACE_WITH_AT_LEAST_32_BYTE_BASE64_KEY
PRESALE_WORKER_HEARTBEAT_MAX_AGE=15s
PRESALE_WORKER_ID=crm-presale-worker-1
PRESALE_WORKER_POLL_INTERVAL=1s
PRESALE_WORKER_LEASE_DURATION=30s
PRESALE_WORKER_BATCH_SIZE=20
PRESALE_WORKER_ALLOW_INSECURE_HTTP=false

# 售前投递 Worker 的审批引擎与 PMS 机器凭据。正式环境必须由部署人员通过
# Secret 管理系统写入真实 HTTPS 地址和凭据；缺失时 Worker 会安全失败关闭，
# CRM 也会继续拒绝新的售前申请。
APPROVAL_TOKEN_URL=PENDING_ONBOARDING
APPROVAL_CLIENT_ID=PENDING_ONBOARDING
APPROVAL_CLIENT_SECRET=PENDING_ONBOARDING
APPROVAL_SCOPE=presale.approval.write
APPROVAL_START_URL=PENDING_ONBOARDING
APPROVAL_ACTION_URL=PENDING_ONBOARDING
PMS_TOKEN_URL=PENDING_ONBOARDING
PMS_CLIENT_ID=PENDING_ONBOARDING
PMS_CLIENT_SECRET=PENDING_ONBOARDING
PMS_SCOPE=presale.worklog.write
PMS_WORKLOG_URL=PENDING_ONBOARDING

# 外部适配器未完成正式接入时全部失败关闭。
PORTAL_INVITE_ENABLED=false
PLATFORM_EXTERNAL_IDENTITY_ENABLED=false
OWNER_DIRECTORY_ENABLED=false
APPROVAL_TASK_RESOLVER_ENABLED=false
PORTAL_PROJECT_HISTORY_ENABLED=false
CONTRACT_VERIFICATION_ENABLED=false
CONTRACT_SUMMARY_URL=http://contract-api:8081/internal/contract-summary
CONTRACT_SUMMARY_TOKEN_URL=http://platform-api:8080/oauth2/token
CONTRACT_SUMMARY_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_SUMMARY_CLIENT_SECRET=PENDING_ONBOARDING
CONTRACT_SUMMARY_SCOPE=contract.summary.read
CONTRACT_TOKEN_URL=http://platform-api:8080/oauth2/token
CONTRACT_OPPORTUNITY_INTAKE_URL=http://contract-api:8081/internal/opportunity-signed-events
CONTRACT_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_CLIENT_SECRET=PENDING_ONBOARDING
CONTRACT_SCOPE=opportunity.signed.write
QB_STATUS_QUERY_ENABLED=false
QB_LAUNCH_ENABLED=false

FILE_GATEWAY_BASE_URL=http://file-gateway:8086
FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind
ATTACHMENT_FILE_GATEWAY_MODE=dual
ATTACHMENT_FILE_GATEWAY_BASE_URL=http://file-gateway:8086
ATTACHMENT_FILE_GATEWAY_TOKEN_URL=http://platform-api:8080/oauth2/token
ATTACHMENT_FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING
ATTACHMENT_FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
ATTACHMENT_FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
ATTACHMENT_FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind

# 附件信任边界：S3 兼容对象存储（AWS S3/MinIO/OSS）优先于本地目录。
# 启用后附件上传/下载绑定不可变 ETag 版本；本地模式仅供受控测试环境。
ATTACHMENT_LOCAL_ENABLED=true
ATTACHMENT_LOCAL_ROOT=/app/data/attachments
ATTACHMENT_S3_ENABLED=false
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_PATH_STYLE=true
ATTACHMENT_S3_PREFIX=crm-attachments

# ClamAV 引擎扫描（附件 + 客户导入）。启用前需启动 --profile clamav 服务
# 或指向已有 clamd 实例；引擎故障时扫描失败关闭，不会放行未扫描文件。
CLAMAV_ENABLED=false
CLAMAV_NETWORK=tcp
CLAMAV_ADDRESS=clamav:3310
