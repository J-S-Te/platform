# 结算与开票生产运行配置。只注入 Settlement 容器；数据库口令保留在部署根 .env。
# 许可运行态键（COMMERCIAL_LICENSE_ENABLED / COMMERCIAL_LICENSE_COMPATIBILITY）不在本模板：
# 由平台写入 runtime/license-<service>.env；兼容放行开关生产必须缺省（缺省即 fail-closed）。
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=PENDING_ONBOARDING
OIDC_IDP_HINT=basic-platform
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=https://platform.example.com/settlement/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/settlement/
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=settlement_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

SETTLEMENT_PUBLIC_ORIGIN=https://platform.example.com
# 仅由生产接入 Agent 根据登记地址协议写入；正式 HTTPS 环境必须保持 false。
SETTLEMENT_ALLOW_INSECURE_HTTP_ORIGIN=false
SETTLEMENT_DEVELOPMENT_AUTH=false
# 与生产清单保持一致；合同入站凭据由受控接入注入，缺失/占位时启动失败关闭。
SETTLEMENT_INTEGRATION_ENABLED=true
# 缺省保留合同接入；独售必须明确开启原生财务并将上面的合同接入置false。
SETTLEMENT_NATIVE_FINANCIAL_ENABLED=false
SETTLEMENT_OUTBOX_BATCH_SIZE=50
SETTLEMENT_INVOICE_ISSUANCE_MODE=manual
SETTLEMENT_CRM_CREDIT_SYNC_ENABLED=false
# 结算→CRM 回款/冲销信用事实同步。scope 固定为 customer.credit.payment.ingest，
# 与 CRM 机器权限白名单及平台 crm_credit_payment_ingest 用途一致；启动期校验，
# 任何历史名字都会让进程失败关闭。客户端凭据只由受控接入注入，不在此填写。
CRM_CREDIT_SYNC_ENDPOINT=http://customer-api:8090/api/v1/internal/credit/payment-events
CRM_CREDIT_TOKEN_URL=http://platform-api:8080/oauth2/token
CRM_CREDIT_SCOPE=customer.credit.payment.ingest
CRM_CREDIT_CLIENT_ID=PENDING_ONBOARDING
CRM_CREDIT_CLIENT_SECRET=PENDING_ONBOARDING
# 与生产清单同值（required）：结算的凭证/票据文件只能经文件网关上传、绑定与下载。
# 该模式下 Settlement/internal/config 启动期要求 FILE_GATEWAY_URL、FILE_GATEWAY_CLIENT_ID、
# FILE_GATEWAY_CLIENT_SECRET、FILE_GATEWAY_SCOPE、SETTLEMENT_FILE_GATEWAY_APPLICATION_ID 非空，
# 未交付 file_gateway 凭据即启动失败关闭，不会退回本地落盘或静默跳过归档；
# 因此必须先由受控接入交付 file_gateway_write 凭据，再按本模板重建运行配置。
SETTLEMENT_FILE_GATEWAY_MODE=required
# 文件网关上传/绑定/下载（与生产清单同值）。URL/token/scope 为固定接线；
# FILE_GATEWAY_CLIENT_ID/SECRET 与 SETTLEMENT_FILE_GATEWAY_APPLICATION_ID 由受控接入注入。
FILE_GATEWAY_URL=http://file-gateway:8086
FILE_GATEWAY_TOKEN_URL=http://platform-api:8080/oauth2/token
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download
FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING

PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUDIT_REQUIRED=true
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_MYSQL_DSN=settlement:${SETTLEMENT_MYSQL_PASSWORD}@tcp(settlement-mysql:3306)/settlement?parseTime=true&charset=utf8mb4&loc=UTC

# Keep this entire group empty until the registered contract source is bound.
PLATFORM_MACHINE_TOKEN_PUBLIC_KEY_PATH=
PLATFORM_MACHINE_TOKEN_ISSUER=
CONTRACT_INTEGRATION_AUDIENCE=basic-platform-application
CONTRACT_INTEGRATION_OAUTH_CLIENT_ID=
CONTRACT_INTEGRATION_APPLICATION_ID=
CONTRACT_INTEGRATION_ENVIRONMENT_ID=
# 合同侧入站身份（与上方同组保持空占位）；由受控接入按已登记的合同来源注入。
CONTRACT_INTEGRATION_CLIENT_ID=

# 项目分配前查询权威引用；接入Agent交付独立只读机器身份。
SETTLEMENT_PROJECT_REFERENCE_URL=http://project-api:8082
SETTLEMENT_PROJECT_REFERENCE_TOKEN_URL=http://platform-api:8080/oauth2/token
SETTLEMENT_PROJECT_REFERENCE_CLIENT_ID=PENDING_ONBOARDING
SETTLEMENT_PROJECT_REFERENCE_CLIENT_SECRET=PENDING_ONBOARDING

# 人员离职交接入站（/internal/v1/handover/*）。平台按批次租户自签短效 application JWT
# （platform-handover / scope handover.machine / 调用方应用 platform），结算侧只用平台
# Ed25519 公钥验签；租户只来自令牌。开关与生产清单一致（true）。
SETTLEMENT_HANDOVER_ENABLED=true
SETTLEMENT_HANDOVER_CLIENT_ID=platform-handover
SETTLEMENT_HANDOVER_AUDIENCE=basic-platform-application
SETTLEMENT_HANDOVER_APPLICATION_CODE=platform
SETTLEMENT_HANDOVER_SCOPE=handover.machine
SETTLEMENT_HANDOVER_ISSUER=basic-platform
SETTLEMENT_HANDOVER_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
SETTLEMENT_HANDOVER_CALLER_ENVIRONMENT_CODE=prod

# 人员目录、提醒通知与审计均由Agent绑定各自的最小权限机器凭据。
PLATFORM_PERSONNEL_DIRECTORY_URL=http://platform-api:8080
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_NOTIFICATION_CLIENT_ID=PENDING_ONBOARDING
SETTLEMENT_NOTIFICATION_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_AUDIT_CLIENT_ID=PENDING_ONBOARDING
SETTLEMENT_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING

# 历史财务暂存独立入口默认关闭；既有HOLD查询与对账仍受权限约束。
# 使用上方已登记的合同机器验签边界，不接受浏览器自报租户。
SETTLEMENT_CONTRACT_IMPORT_ENABLED=false

# 由受控接入写入中央会话开关与本应用外部入口，正式值以平台登记为准。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=PENDING_ONBOARDING
# 中央会话只读缓存（显式登记，生产默认关闭）：单位毫秒，0=关闭，上限 5000。
# 开启后平台侧撤销/登出的本地生效延迟 ≤ 该值，须确认业务可接受吊销延迟后才开启；
# 超过上限按 5000 处理，非法值回退代码缺省 2000。
CENTRAL_SESSION_CACHE_MS=0
