# 结算与开票生产运行配置。只注入 Settlement 容器；数据库口令保留在部署根 .env。
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_IDP_HINT=basic-platform
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=https://platform.example.com/settlement/auth/callback
OIDC_POST_LOGOUT_URI=https://platform.example.com/settlement/
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=settlement_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

SETTLEMENT_PUBLIC_ORIGIN=https://platform.example.com
SETTLEMENT_DEVELOPMENT_AUTH=false
SETTLEMENT_INTEGRATION_ENABLED=false
SETTLEMENT_OUTBOX_BATCH_SIZE=50
SETTLEMENT_INVOICE_ISSUANCE_MODE=manual
SETTLEMENT_CRM_CREDIT_SYNC_ENABLED=false
SETTLEMENT_FILE_GATEWAY_MODE=disabled

PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
