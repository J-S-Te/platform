# 结算与开票生产运行配置。只注入 Settlement 容器；数据库口令保留在部署根 .env。
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=PENDING_ONBOARDING
OIDC_IDP_HINT=basic-platform
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=https://platform.example.com/settlement/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/settlement/
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=settlement_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

SETTLEMENT_PUBLIC_ORIGIN=https://platform.example.com
# 仅由生产接入 Agent 根据登记地址协议写入；正式 HTTPS 环境必须保持 false。
SETTLEMENT_ALLOW_INSECURE_HTTP_ORIGIN=false
SETTLEMENT_DEVELOPMENT_AUTH=false
SETTLEMENT_INTEGRATION_ENABLED=false
SETTLEMENT_OUTBOX_BATCH_SIZE=50
SETTLEMENT_INVOICE_ISSUANCE_MODE=manual
SETTLEMENT_CRM_CREDIT_SYNC_ENABLED=false
SETTLEMENT_FILE_GATEWAY_MODE=disabled

PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_MYSQL_DSN=settlement:${SETTLEMENT_MYSQL_PASSWORD}@tcp(settlement-mysql:3306)/settlement?parseTime=true&charset=utf8mb4&loc=UTC

# Keep this entire group empty until the registered contract source is bound.
PLATFORM_MACHINE_TOKEN_PUBLIC_KEY_PATH=
PLATFORM_MACHINE_TOKEN_ISSUER=
CONTRACT_INTEGRATION_OAUTH_CLIENT_ID=
CONTRACT_INTEGRATION_APPLICATION_ID=
CONTRACT_INTEGRATION_ENVIRONMENT_ID=

# 项目分配前查询权威引用；接入Agent交付独立只读机器身份。
SETTLEMENT_PROJECT_REFERENCE_URL=http://project-api:8082
SETTLEMENT_PROJECT_REFERENCE_TOKEN_URL=http://platform-api:8080/oauth2/token
SETTLEMENT_PROJECT_REFERENCE_CLIENT_ID=PENDING_ONBOARDING
SETTLEMENT_PROJECT_REFERENCE_CLIENT_SECRET=PENDING_ONBOARDING

# 人员目录、提醒通知与审计均由Agent绑定各自的最小权限机器凭据。
PLATFORM_PERSONNEL_DIRECTORY_URL=http://platform-api:8080
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_NOTIFICATION_CLIENT_ID=PENDING_ONBOARDING
SETTLEMENT_NOTIFICATION_CLIENT_SECRET=PENDING_ONBOARDING
SETTLEMENT_AUDIT_CLIENT_ID=PENDING_ONBOARDING
SETTLEMENT_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING

# 历史财务暂存独立入口默认关闭；既有HOLD查询与对账仍受权限约束。
# 使用上方已登记的合同机器验签边界，不接受浏览器自报租户。
SETTLEMENT_CONTRACT_IMPORT_ENABLED=false
