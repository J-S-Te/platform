# Independent report worker; never copy the API identity-read secret.
PORTAL_REPORT_WORKER_MYSQL_DSN=portal:${PORTAL_MYSQL_PASSWORD}@tcp(portal-mysql:3306)/customer_portal?charset=utf8mb4&parseTime=true&loc=UTC&multiStatements=true
PORTAL_OIDC_TENANT_ID=PENDING_ONBOARDING
PORTAL_REPORT_INGEST_DESCRIPTOR_KEY_BASE64=PENDING_ONBOARDING
PORTAL_REPORT_CONTENT_KEY_BASE64=PENDING_ONBOARDING
PORTAL_REPORT_STORE_ROOT=/app/data/portal-reports
PORTAL_REPORT_SOURCE_BASE_URL=http://file-gateway:8086
PORTAL_REPORT_SOURCE_TOKEN_URL=http://platform-api:8080/oauth2/token
PORTAL_REPORT_SOURCE_CLIENT_ID=PENDING_ONBOARDING
PORTAL_REPORT_SOURCE_CLIENT_SECRET=PENDING_ONBOARDING
PORTAL_REPORT_WORKER_INGEST_ONLY=true
PORTAL_REPORT_PROJECT_TOKEN_URL=
PORTAL_REPORT_PROJECT_CLIENT_ID=
PORTAL_REPORT_PROJECT_CLIENT_SECRET=
PORTAL_REPORT_PROJECT_REQUEST_URL=
PLATFORM_APPLICATION_CODE=customer_portal
PLATFORM_ENVIRONMENT_CODE=prod
