# 数据看板 data_analysis/prod 运行配置。平台接入后写入 OIDC、授权目录和审计凭据。
# 许可运行态键（COMMERCIAL_LICENSE_ENABLED / COMMERCIAL_LICENSE_COMPATIBILITY）不在本模板：
# 由平台写入 runtime/license-<service>.env；兼容放行开关生产必须缺省（缺省即 fail-closed）。
APP_PATH_PREFIX=/data_analysis
APP_PUBLIC_ORIGIN=https://platform.example.com
COOKIE_SECURE=true
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=PENDING_ONBOARDING
OIDC_IDP_HINT=basic-platform
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_SCOPES=openid profile
OIDC_REDIRECT_URI=https://platform.example.com/data_analysis/auth/callback
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=data_analysis_session
# 浏览器会话双期限：空闲 30 分钟（真实用户操作续期）+ 绝对上限 8 小时。
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
OIDC_ROLE_CONFIG_HASH=PENDING_ONBOARDING
OIDC_CODEC_KEY=REPLACE_WITH_64_HEX_CHAR_CODEC_KEY
PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_APPLICATION_CODE=data_analysis
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=http://platform-api:8080/oauth2/authorization-context
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_REQUIRED=true
AUDIT_WORKER_ID=data-analysis-dashboard-api
# 合同与项目使用两套平台 OAuth 机器凭据，禁止复用或改回 Keycloak service account。
MACHINE_TOKEN_URL=http://platform-api:8080/oauth2/token
MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
CONTRACT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
CONTRACT_MACHINE_TOKEN_SCOPE=dashboard.contract.read
PROJECT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
PROJECT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
PROJECT_MACHINE_TOKEN_SCOPE=dashboard.project.read
CONTRACT_INTERNAL_URL=http://contract-api:8081/internal/v1/dashboard
PROJECT_INTERNAL_URL=http://project-api:8082/internal/v1/dashboard
# 独立完整项目投影；即使没有 PROJECT_READ_DSN 也可同步项目维表。
PROJECT_PROJECTION_URL=http://project-api:8082/internal/v1/dashboard/projects/snapshot
PROJECT_PROJECTION_HTTP_TIMEOUT=35s
PROJECT_PROJECTION_MAX_PROJECTS=50000
PROJECT_PROJECTION_MAX_BYTES=67108864
PROJECT_PROJECTION_MAX_LINE_BYTES=65536
METABASE_INTERNAL_URL=http://data-analysis-metabase:3000
# Independent cookie domain; retained operator configuration, not generated credentials.
# embed-proxy 只对“精确等于本值”的 Origin 回显 CORS（规范化后全等，不做前缀/子域/端口通配）；
# `Origin: null`（沙箱 iframe、file://、部分跳转重定向）及任何不透明源一律不放行。
# 未配置（空值）时不回显 CORS：嵌入页的跨源读取/一次性令牌请求会失败（业务 API 不受影响）。
BI_EMBED_PUBLIC_ORIGIN=
METABASE_BASE_PATH=/
METABASE_EMBEDDING_SECRET=PENDING_ONBOARDING
MB_DASHBOARD_ID_OVERVIEW=
MB_DASHBOARD_ID_CONTRACT=
MB_DASHBOARD_ID_PROJECT=
MB_DASHBOARD_ID_REPORT=
MB_DASHBOARD_ID_FINANCE=
DASHBOARD_MYSQL_DSN=dashboard:${DASHBOARD_MYSQL_PASSWORD}@tcp(data-analysis-mysql:3306)/dashboard_aggregation?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# 历史导入采用独立确认与最小权限机器身份；新增默认关闭。
# 完整接入组由受控登记流程填入，不能复用普通统计或项目的凭据。
CONTRACT_IMPORT_SYNC_ENABLED=false
CONTRACT_IMPORT_SUMMARY_URL=
CONTRACT_IMPORT_SYNC_TOKEN_URL=
CONTRACT_IMPORT_SYNC_CLIENT_ID=
CONTRACT_IMPORT_SYNC_CLIENT_SECRET=
CONTRACT_IMPORT_SYNC_SCOPE=contract.import.report.read
CONTRACT_IMPORT_STATUS_ISSUER=
CONTRACT_IMPORT_STATUS_AUDIENCE=
CONTRACT_IMPORT_STATUS_PUBLIC_KEY_PATH=
CONTRACT_IMPORT_STATUS_CLIENT_ID=
CONTRACT_IMPORT_STATUS_TENANT_ID=
CONTRACT_IMPORT_STATUS_CALLER_ENVIRONMENT_CODE=
# 报表状态端点（BIZ-XAPI-13）的期望 OAuth client 身份：只由受控接入写入，必须是合同侧
# 签发给数析的 analysis-import-report-status 客户端 ID。留空时 Verifier 不构造、
# 内部端点不挂载（fail-closed），不会以“未绑定任何客户端”放行同租户任意调用方。
REPORT_STATUS_MACHINE_OAUTH_CLIENT_ID=
# 告警生命周期收敛（BIZ-DATA-07）：默认 false，保持“只增不关”的现网行为。
# 运维启用开关写在 Compose 插值来源 .env 的 ALERT_AUTO_RESOLVE，不是本 runtime 文件
# （Compose environment 会覆盖同名 runtime 键）；这里显式记录默认值，避免按模板重建后
# 该开关在下一次评审时无从追溯。
ALERT_AUTO_RESOLVE=false

# 由受控接入写入中央会话开关与本应用外部入口，正式值以平台登记为准。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=PENDING_ONBOARDING
