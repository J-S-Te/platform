# 数据看板 data_analysis/prod 运行配置。平台接入后写入 OIDC、授权目录和审计凭据。
APP_PATH_PREFIX=/data_analysis
APP_PUBLIC_ORIGIN=http://47.111.20.119:8081
COOKIE_SECURE=false
OIDC_ISSUER=http://47.111.20.119:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=http://47.111.20.119:8081/data_analysis/auth/callback
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_ROLE_CONFIG_HASH=PENDING_ONBOARDING
OIDC_CODEC_KEY=REPLACE_WITH_64_HEX_CHAR_CODEC_KEY
PLATFORM_BASE_URL=http://platform-api:8080
PLATFORM_APPLICATION_CODE=data_analysis
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=http://platform-api:8080/oauth2/authorization-context
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_REQUIRED=true
FILE_GATEWAY_BASE_URL=http://file-gateway:8086
FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind
AUDIT_WORKER_ID=data-analysis-dashboard-api
# 合同与项目使用两套平台 OAuth 机器凭据，禁止复用或改回 Keycloak service account。
MACHINE_TOKEN_URL=http://platform-api:8080/oauth2/token
MACHINE_TOKEN_ISSUER=basic-platform
MACHINE_TOKEN_AUDIENCE=basic-platform-application
CONTRACT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
CONTRACT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
CONTRACT_MACHINE_TOKEN_SCOPE=dashboard.contract.read
PROJECT_MACHINE_CLIENT_ID=PENDING_ONBOARDING
PROJECT_MACHINE_CLIENT_SECRET=PENDING_ONBOARDING
PROJECT_MACHINE_TOKEN_SCOPE=dashboard.project.read
CONTRACT_INTERNAL_URL=http://contract-api:8081/internal/v1/dashboard
PROJECT_INTERNAL_URL=http://project-api:8082/internal/v1/dashboard
METABASE_INTERNAL_URL=http://data-analysis-metabase:3000
METABASE_BASE_PATH=/
METABASE_EMBEDDING_SECRET=PENDING_ONBOARDING
MB_DASHBOARD_ID_OVERVIEW=
