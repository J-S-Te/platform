# 客户 Portal 独立运行配置。复制到 runtime/portal.env，权限必须为 0600。
# 许可运行态键（COMMERCIAL_LICENSE_ENABLED / COMMERCIAL_LICENSE_COMPATIBILITY）不在本模板：
# 由平台写入 runtime/license-<service>.env；兼容放行开关生产必须缺省（缺省即 fail-closed）。
PORTAL_HTTP_ADDRESS=:8091
PORTAL_PATH_PREFIX=/customer-portal
PORTAL_PUBLIC_ORIGIN=https://platform.example.com

PORTAL_OIDC_ISSUER=PENDING_ONBOARDING
PORTAL_OIDC_BACKCHANNEL_BASE_URL=PENDING_ONBOARDING
PORTAL_OIDC_CLIENT_ID=PENDING_ONBOARDING
PORTAL_OIDC_CLIENT_SECRET=PENDING_ONBOARDING
PORTAL_OIDC_IDP_HINT=basic-platform-customer
PORTAL_OIDC_REDIRECT_URI=https://platform.example.com/customer-portal/auth/callback
PORTAL_OIDC_SCOPES=openid profile
PORTAL_OIDC_TENANT_ID=PENDING_ONBOARDING
PORTAL_ROLE_CONFIG_HASH=PENDING_ONBOARDING
PORTAL_SESSION_COOKIE_NAME=customer_portal_session
PORTAL_SESSION_COOKIE_SECURE=true
PORTAL_SESSION_TTL=15m
PORTAL_ACCOUNT_SECURITY_CENTER_URL=https://platform.example.com/settings/security

# 匿名登录入口限流（安全审计 M-10）。额度为「每窗口每客户端地址」；0 表示取内置默认值，
# 不等于关闭限流。启动时校验区间（1..600 次/窗口，窗口 1s..1h）。
PORTAL_LOGIN_RATE_LIMIT=20
PORTAL_ACTIVATE_RATE_LIMIT=20
PORTAL_CALLBACK_RATE_LIMIT=30
PORTAL_AUTH_RATE_LIMIT_WINDOW=1m

# 可信反向代理（安全审计 M-10）。限流桶键与登录 IP 归因共用该名单：只有直接对端命中
# 名单时才采信 X-Real-IP/X-Forwarded-For。Portal 容器的直接对端是 frontend（默认
# 172.31.255.250），缺失或配错会让所有客户端退化成一个桶，一次突发即可锁死全站登录。
# 取值必须与 compose.yaml 中 platform-api 的收敛口径一致；网关/前端 IP 变更时同步修改。
APP_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.31.255.1/32,172.31.255.250/32

PORTAL_MACHINE_TOKEN_ISSUER=basic-platform
PORTAL_MACHINE_TOKEN_AUDIENCE=basic-platform-application
PORTAL_MACHINE_TOKEN_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
PORTAL_CRM_PROVISION_CLIENT_SUBJECT=PENDING_ONBOARDING
PORTAL_CRM_DISABLE_CLIENT_SUBJECT=PENDING_ONBOARDING

PORTAL_CRM_INVITE_BASE_URL=http://customer-api:8090/customer-opportunity/api/v1
PORTAL_CRM_INVITE_TOKEN_URL=http://platform-api:8080/oauth2/token
PORTAL_CRM_INVITE_CLIENT_ID=PENDING_ONBOARDING
PORTAL_CRM_INVITE_CLIENT_SECRET=PENDING_ONBOARDING
PORTAL_CRM_INVITE_SCOPE=portal.invite.verify

PORTAL_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
PORTAL_REPORT_INGEST_DESCRIPTOR_KEY_BASE64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY
PORTAL_HMAC_KEY_BASE64=REPLACE_WITH_AT_LEAST_32_BYTE_BASE64_KEY
PORTAL_PROJECT_HISTORY_STALE_AFTER=10m

PORTAL_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PORTAL_PLATFORM_BASE_URL=http://platform-api:8080
PORTAL_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PORTAL_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PORTAL_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PORTAL_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING

PLATFORM_APPLICATION_CODE=customer_portal
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUDIT_REQUIRED=true
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_WORKER_ID=portal-api-audit
PLATFORM_AUDIT_POLL_INTERVAL=1s
PLATFORM_AUDIT_BATCH_SIZE=100

FILE_GATEWAY_BASE_URL=http://file-gateway:8086
FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download
PORTAL_MYSQL_DSN=portal:${PORTAL_MYSQL_PASSWORD}@tcp(portal-mysql:3306)/customer_portal?charset=utf8mb4&parseTime=true&loc=UTC&multiStatements=true

# Private vault: API owns only the identity-read client.
PORTAL_REPORT_CONTENT_KEY_BASE64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY
PORTAL_REPORT_STORE_ROOT=/app/data/portal-reports
PORTAL_REPORT_IDENTITY_URL=http://customer-api:8090/customer-opportunity/api/v1/internal/portal-report/download-identity
PORTAL_REPORT_IDENTITY_CLIENT_ID=PENDING_ONBOARDING
PORTAL_REPORT_IDENTITY_CLIENT_SECRET=PENDING_ONBOARDING
PORTAL_PDF_CONFIG_ROOT=/app/data/portal-reports/pdfcpu
PORTAL_CJK_FONT_PATH=/app/assets/fonts/UIPPortalSans-Regular.ttf

# 由受控接入写入中央会话开关与本应用外部入口，正式值以平台登记为准。
PORTAL_CENTRAL_SESSION_ENABLED=false
PORTAL_CENTRAL_SESSION_PUBLIC_BASE_URL=PENDING_ONBOARDING
