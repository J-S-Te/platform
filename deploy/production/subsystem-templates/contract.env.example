# 合同管理运行时专用配置。该文件只注入 contract-api/contract-migrate，禁止放入平台
# 数据库口令、IAM Bootstrap Token、手机号加密密钥等基础平台秘密。
OIDC_ISSUER=http://47.111.20.119:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=https://platform.example.com/contract_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/contract_management/logged-out
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=contract_management_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_TTL=15m
APP_PUBLIC_URL=https://platform.example.com/contract_management/
APP_PATH_PREFIX=/contract_management

PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_APPLICATION_CODE=contract_management
PLATFORM_ENVIRONMENT_CODE=prod

# 内部机器接口验证基础平台 application JWT；未配置时 /internal/* 返回 503。
CONTRACT_MACHINE_TOKEN_ISSUER=PENDING_ONBOARDING
CONTRACT_MACHINE_TOKEN_AUDIENCE=basic-platform-application
CONTRACT_MACHINE_TOKEN_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_TLS=false
APPROVAL_NODE_TIMEOUT=72h
APPROVAL_REMINDER_INTERVAL=24h
ARCHIVE_CRON_SCHEDULE=0 16 * * *
APPROVER_ROLE_ASSIGNMENTS_JSON={}
