# 合同管理运行时专用配置。该文件只注入 contract-api/contract-migrate，禁止放入平台
# 数据库口令、IAM Bootstrap Token、手机号加密密钥等基础平台秘密。
# 许可运行态键（COMMERCIAL_LICENSE_ENABLED / COMMERCIAL_LICENSE_COMPATIBILITY）不在本模板：
# 由平台写入 runtime/license-<service>.env；兼容放行开关生产必须缺省（缺省即 fail-closed）。
OIDC_ISSUER=PENDING_ONBOARDING
OIDC_BACKCHANNEL_BASE_URL=PENDING_ONBOARDING
OIDC_CLIENT_ID=PENDING_ONBOARDING
OIDC_CLIENT_SECRET=PENDING_ONBOARDING
OIDC_REDIRECT_URI=https://platform.example.com/contract_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/contract_management/logged-out
# 将合同 Client 定向到基础平台 Broker；Keycloak 本地恢复管理员入口保持不受影响。
OIDC_IDP_HINT=basic-platform
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=PENDING_ONBOARDING
OIDC_SESSION_COOKIE_NAME=contract_management_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
# 合同自有列加密密钥（SEC-D7b）：签署人手机号 AES-GCM 加密，Base64 解码恰好 32 字节；
# 由 Agent 依 generated_keys 在 prepare/onboard 时生成；非头部所禁的平台基础秘密。
SIGNING_PHONE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
# 浏览器会话双期限：空闲 30 分钟（真实用户操作续期）+ 绝对上限 8 小时。
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
APP_PUBLIC_URL=https://platform.example.com/contract_management/
APP_PATH_PREFIX=/contract_management

PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CONTEXT_URL=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_AUDIT_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_NOTIFICATION_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_NOTIFICATION_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=PENDING_ONBOARDING
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=PENDING_ONBOARDING
PLATFORM_APPLICATION_CODE=contract_management
PLATFORM_ENVIRONMENT_CODE=prod
PLATFORM_AUDIT_REQUIRED=true
# 审计 outbox「已投递行」本地清理（显式登记，生产默认关闭）：0=关闭清理，正整数=保留天数。
# 删除的是仅保存在本地的已投递审计证据，开启前必须完成保留期审批，且保留期不得短于审计要求；
# 各子系统代码缺省值曾不一致（合同侧曾默认 30 天清理），生产必须显式写 0，不能留空依赖缺省。
AUDIT_OUTBOX_DELIVERED_RETENTION_DAYS=0

FILE_GATEWAY_BASE_URL=http://file-gateway:8086
FILE_GATEWAY_APPLICATION_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_ID=PENDING_ONBOARDING
FILE_GATEWAY_CLIENT_SECRET=PENDING_ONBOARDING
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download
# 生产先采用双写：网关成功是主路径，历史 BLOB 仅作为迁移期回退；完成数据回填后再切 required。
STAMPED_FILE_GATEWAY_MODE=dual

# 外部合同创建时服务端向 CRM 复核活动客户及商机归属；缺失或调用失败时创建失败关闭。
# 来源自动解析（档一）：CRM_REFERENCE_ENABLED 不在此预置；受控接入/更新按
# customer.env 接入就绪事实解析并连带写入本键（显式手设值保留）。
CRM_REFERENCE_BASE_URL=http://customer-api:8090/customer-opportunity
CRM_REFERENCE_TOKEN_URL=http://platform-api:8080/oauth2/token
CRM_REFERENCE_CLIENT_ID=PENDING_ONBOARDING
CRM_REFERENCE_CLIENT_SECRET=PENDING_ONBOARDING
CRM_REFERENCE_SCOPE=customer.contract_reference.read

# 合同审核完成后把商机关联结论回写 CRM；使用平台 client_credentials 专用用途
# （scope 固定 opportunity.signed.write），CRM 侧同时校验时间戳与一次性 nonce。
# CRM_LINK_CLIENT_ID/SECRET 由受控接入注入；模板默认关闭该边（BASE_URL 留空），
# 生产清单才启用。手工部署需先完成凭据交付再填 BASE_URL，否则凭据缺失/为空/占位时
# 合同启动失败关闭（不静默关闭、不发静态 Bearer）。
CRM_LINK_BASE_URL=
# 空值沿用原URL配置；显式false停用回写，不被profile的固定URL重启。
CRM_LINK_ENABLED=
CRM_LINK_TOKEN_URL=http://platform-api:8080/oauth2/token
CRM_LINK_CLIENT_ID=PENDING_ONBOARDING
CRM_LINK_CLIENT_SECRET=PENDING_ONBOARDING
CRM_LINK_SCOPE=opportunity.signed.write

# 历史合同批量导入时自动开立 CRM 客户/商机（导入专用通道，默认关闭）。
# 平台按“一用途一 client 一 scope”授予：CRM_PROVISION_* 是客户查询/创建用途
# （crm_customer_import_provision），CRM_PROVISION_OPPORTUNITY_* 是商机创建与
# 推进用途（crm_opportunity_import_provision）。两对凭据都由受控接入注入；
# 缺失/为空/占位且开关开启时，合同启动失败关闭。
CONTRACT_IMPORT_CRM_PROVISION_ENABLED=false
CRM_PROVISION_BASE_URL=http://customer-api:8090/customer-opportunity
CRM_PROVISION_TOKEN_URL=http://platform-api:8080/oauth2/token
CRM_PROVISION_CLIENT_ID=PENDING_ONBOARDING
CRM_PROVISION_CLIENT_SECRET=PENDING_ONBOARDING
CRM_PROVISION_SCOPE=customer.import_provision
CRM_PROVISION_OPPORTUNITY_CLIENT_ID=PENDING_ONBOARDING
CRM_PROVISION_OPPORTUNITY_CLIENT_SECRET=PENDING_ONBOARDING
CRM_PROVISION_OPPORTUNITY_SCOPE=opportunity.import_provision

# 合同生效后投递项目，并读取项目管理维护的检测类别目录。
# 来源自动解析（档一）：PROJECT_INTEGRATION_ENABLED 不在此预置；受控接入/更新按
# project.env 接入就绪事实解析并连带写入本键（显式手设值保留）。
PROJECT_API_BASE_URL=http://project-api:8082
PROJECT_INTEGRATION_TOKEN_URL=http://platform-api:8080/oauth2/token
PROJECT_INTEGRATION_CLIENT_ID=PENDING_ONBOARDING
PROJECT_INTEGRATION_CLIENT_SECRET=PENDING_ONBOARDING
PROJECT_INTEGRATION_AUDIENCE=basic-platform-application
PROJECT_INTEGRATION_POLL_INTERVAL=2s
PROJECT_INTEGRATION_MAX_ATTEMPTS=20

# 内部机器接口验证基础平台 application JWT；未配置时 /internal/* 返回 503。
CONTRACT_MACHINE_TOKEN_ISSUER=PENDING_ONBOARDING
CONTRACT_MACHINE_TOKEN_AUDIENCE=basic-platform-application
CONTRACT_MACHINE_TOKEN_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem

# CRM 按商机批量读取已通过审批的合同数量；只接受绑定当前环境的最小权限机器令牌。
CRM_SIGNED_COUNT_MACHINE_ENABLED=true
CRM_SIGNED_COUNT_MACHINE_REQUIRE_BEARER=true
CRM_SIGNED_COUNT_MACHINE_ISSUER=basic-platform
CRM_SIGNED_COUNT_MACHINE_AUDIENCE=basic-platform-application
CRM_SIGNED_COUNT_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
CRM_SIGNED_COUNT_MACHINE_CLIENT_ID=customer_and_opportunity-prod-contract-signed-count
CRM_SIGNED_COUNT_MACHINE_CALLER_APPLICATION_CODE=customer_and_opportunity
CRM_SIGNED_COUNT_MACHINE_CALLER_ENVIRONMENT_CODE=prod
CRM_SIGNED_COUNT_MACHINE_REQUIRED_SCOPE=contract.opportunity_signed_count.read

# CRM 商机签单事件入站：CRM contract-transfer-worker 投递，未开启时整组
# /internal/opportunity-signed-events 路由不注册（首投即 404 死信）。
CRM_OPPORTUNITY_INTAKE_MACHINE_ENABLED=true
CRM_OPPORTUNITY_INTAKE_MACHINE_REQUIRE_BEARER=true
CRM_OPPORTUNITY_INTAKE_MACHINE_ISSUER=basic-platform
CRM_OPPORTUNITY_INTAKE_MACHINE_AUDIENCE=basic-platform-application
CRM_OPPORTUNITY_INTAKE_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
CRM_OPPORTUNITY_INTAKE_MACHINE_CLIENT_ID=customer_and_opportunity-prod-opportunity-intake
CRM_OPPORTUNITY_INTAKE_MACHINE_CALLER_APPLICATION_CODE=customer_and_opportunity
CRM_OPPORTUNITY_INTAKE_MACHINE_CALLER_ENVIRONMENT_CODE=prod
CRM_OPPORTUNITY_INTAKE_MACHINE_REQUIRED_SCOPE=opportunity.signed.write

# CRM 商机签约收口读取合同摘要；只接受绑定当前环境的最小权限机器令牌。
CONTRACT_SUMMARY_MACHINE_ENABLED=true
CONTRACT_SUMMARY_MACHINE_REQUIRE_BEARER=true
CONTRACT_SUMMARY_MACHINE_ISSUER=basic-platform
CONTRACT_SUMMARY_MACHINE_AUDIENCE=basic-platform-application
CONTRACT_SUMMARY_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
CONTRACT_SUMMARY_MACHINE_CLIENT_ID=customer_and_opportunity-prod-contract-summary
CONTRACT_SUMMARY_MACHINE_CALLER_APPLICATION_CODE=customer_and_opportunity
CONTRACT_SUMMARY_MACHINE_CALLER_ENVIRONMENT_CODE=prod
CONTRACT_SUMMARY_MACHINE_REQUIRED_SCOPE=contract.summary.read

# 数析看板读取合同明细（dashboard.contract.read）。调用方固定为 data_analysis 应用，
# 只接受绑定当前环境的最小权限机器令牌；与生产清单同值，避免按模板重建后续期接口 401。
DASHBOARD_MACHINE_ENABLED=true
DASHBOARD_MACHINE_REQUIRE_BEARER=true
DASHBOARD_MACHINE_ISSUER=basic-platform
DASHBOARD_MACHINE_AUDIENCE=basic-platform-application
DASHBOARD_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
DASHBOARD_MACHINE_CLIENT_ID=data_analysis-prod-contract-dashboard
DASHBOARD_MACHINE_CALLER_APPLICATION_CODE=data_analysis
DASHBOARD_MACHINE_CALLER_ENVIRONMENT_CODE=prod
DASHBOARD_MACHINE_REQUIRED_SCOPE=dashboard.contract.read

# 项目管理在立项/拆解服务项时读取“已审批合同”清单（contract.approved.internal.read）。
# 调用方固定为 project_management 应用，只接受绑定当前环境的最小权限机器令牌。
PROJECT_APPROVAL_MACHINE_ENABLED=true
PROJECT_APPROVAL_MACHINE_REQUIRE_BEARER=true
PROJECT_APPROVAL_MACHINE_ISSUER=basic-platform
PROJECT_APPROVAL_MACHINE_AUDIENCE=basic-platform-application
PROJECT_APPROVAL_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
PROJECT_APPROVAL_MACHINE_CLIENT_ID=project_management-prod-contract-approved-reader
PROJECT_APPROVAL_MACHINE_CALLER_APPLICATION_CODE=project_management
PROJECT_APPROVAL_MACHINE_CALLER_ENVIRONMENT_CODE=prod
PROJECT_APPROVAL_MACHINE_REQUIRED_SCOPE=contract.approved.internal.read

# 人员离职交接入站（/internal/v1/handover/*）。平台按批次租户自签短效 application JWT
# （platform-handover / scope handover.machine / 调用方应用 platform），合同侧只持有平台
# Ed25519 公钥验签，不再接受静态机器令牌；租户只来自令牌，请求体或请求头不能覆盖。
# 开关与生产清单一致（true）；缺少 ISSUER/AUDIENCE/PUBLIC_KEY_PATH/CLIENT_ID 时启动失败关闭。
HANDOVER_MACHINE_ENABLED=true
HANDOVER_MACHINE_REQUIRE_BEARER=true
HANDOVER_MACHINE_ISSUER=basic-platform
HANDOVER_MACHINE_AUDIENCE=basic-platform-application
HANDOVER_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
HANDOVER_MACHINE_CLIENT_ID=platform-handover
HANDOVER_MACHINE_CALLER_APPLICATION_CODE=platform
HANDOVER_MACHINE_CALLER_ENVIRONMENT_CODE=prod
HANDOVER_MACHINE_REQUIRED_SCOPE=handover.machine

TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_WORKER_BUILD_ID=contract-worker-v1
TEMPORAL_WORKER_DEPLOYMENT_NAME=contract-management
# 迁移历史 UNVERSIONED 工作流期间保持 false。开启前必须先注册并提升 Current
# Deployment 版本，同时确认未版本化任务队列已排空。
TEMPORAL_WORKER_VERSIONING_ENABLED=false
TEMPORAL_WORKER_VERSIONING_POLICY=PINNED
# Worker 私有 Prometheus 端口；由集群监控抓取，不对公网暴露。
TEMPORAL_METRICS_ADDRESS=:9091
TEMPORAL_TLS=false
APPROVAL_NODE_TIMEOUT=72h
APPROVAL_REMINDER_INTERVAL=24h
ARCHIVE_CRON_SCHEDULE=0 16 * * *
# 合同编号登记表漂移的每日只读巡检（默认每天 17:00，比归档错开一小时）。
# 显式置空表示禁用该周期巡检；只记日志/指标，不主动通知任何人。
NUMBER_AUDIT_CRON_SCHEDULE=0 17 * * *
APPROVER_ROLE_ASSIGNMENTS_JSON={}
MYSQL_DSN=contract:${CONTRACT_MYSQL_PASSWORD}@tcp(contract-mysql:3306)/contract_management?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# 合同→结算出站：受控接入凭据（CLIENT_ID/CLIENT_SECRET）由接入流程注入，
# 不在模板/仓库中出现明文。默认true保持既有组合，受控更新保留已选false；启用时要求
# TOKEN_URL/CLIENT_ID/CLIENT_SECRET 均非空，缺失或为空时启动直接失败
# （fail-closed），不得静默关闭整条边。
SETTLEMENT_INTEGRATION_OUTBOUND_ENABLED=true
SETTLEMENT_API_BASE_URL=http://settlement-api:8085
SETTLEMENT_INTEGRATION_TOKEN_URL=http://platform-api:8080/oauth2/token
SETTLEMENT_INTEGRATION_CLIENT_ID=
SETTLEMENT_INTEGRATION_CLIENT_SECRET=
SETTLEMENT_INTEGRATION_AUDIENCE=basic-platform-application

# 受控“合同财务变更”入口（BIZ-XEVT2-05 合同侧）：默认关闭（fail-closed）。关闭时
# 写接口直接拒绝；开启后仍由 contract.edit 权限、合同已审批且无在途审批、审计三重
# 门禁把守，变更成功同事务 version+1 并向结算发出新的财务事件。
# 生产开启需产品确认（单人改额口径尚未签认），故当前与生产清单同为 false；
# 改为 true 时必须同步修改生产清单，避免按模板重建时静默开或关该入口。
CONTRACT_FINANCIAL_CHANGE_ENABLED=false

# 外部PDF和批次默认关闭；关闭新增不停止已有台账查询和受控恢复。
CONTRACT_EXTERNAL_PDF_ENABLED=false
CONTRACT_IMPORT_ENABLED=false
CONTRACT_IMPORT_HISTORY_ENABLED=false
# 能力开关：开启后历史导入才允许自动审批（按声明状态归档、跳过人工会签；
# ARCHIVE_ONLY 恒为 archived；HISTORICAL_CLOSED 取清单 historical_status）。
# 开启后仍须由合同系统超级管理员（角色 admin）在控制台按租户开启运行开关，
# 租户运行开关默认关闭；两者同时开启才生效。开启时必须同时满足
# CONTRACT_IMPORT_HISTORY_ENABLED=true 与 CONTRACT_IMPORT_CRM_PROVISION_ENABLED=true，
# 否则合同侧启动失败关闭。生产开启需产品确认并同步生产清单。
CONTRACT_IMPORT_AUTO_APPROVE_HISTORICAL=false
CONTRACT_IMPORT_MAX_ITEMS=100
CONTRACT_IMPORT_MAX_CONCURRENCY=1
CONTRACT_IMPORT_STAGING_TTL=168h

# 历史导入采用独立确认与最小权限机器身份；新增默认关闭。
# 完整接入组由受控登记流程填入，不能复用普通统计或项目的凭据。
CONTRACT_IMPORT_CONFIRMATION_ROLES=
CONTRACT_IMPORT_PROJECT_BASE_URL=
CONTRACT_IMPORT_PROJECT_TOKEN_URL=
CONTRACT_IMPORT_PROJECT_CLIENT_ID=
CONTRACT_IMPORT_PROJECT_CLIENT_SECRET=
CONTRACT_IMPORT_PROJECT_SCOPE=project.contract.import
CONTRACT_IMPORT_FINANCE_BASE_URL=
CONTRACT_IMPORT_FINANCE_TOKEN_URL=
CONTRACT_IMPORT_FINANCE_CLIENT_ID=
CONTRACT_IMPORT_FINANCE_CLIENT_SECRET=
CONTRACT_IMPORT_FINANCE_SCOPE=settlement.contract.ingest
CONTRACT_IMPORT_REPORT_BASE_URL=
CONTRACT_IMPORT_REPORT_TOKEN_URL=
CONTRACT_IMPORT_REPORT_CLIENT_ID=
CONTRACT_IMPORT_REPORT_CLIENT_SECRET=
CONTRACT_IMPORT_REPORT_SCOPE=analysis.contract-import.report-status
CONTRACT_IMPORT_REPORT_READ_ISSUER=
CONTRACT_IMPORT_REPORT_READ_AUDIENCE=
CONTRACT_IMPORT_REPORT_READ_PUBLIC_KEY_PATH=
CONTRACT_IMPORT_REPORT_READ_CLIENT_ID=
CONTRACT_IMPORT_REPORT_READ_CALLER_ENVIRONMENT_CODE=

# 由受控接入写入中央会话开关与本应用外部入口，正式值以平台登记为准。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=PENDING_ONBOARDING
# 中央会话只读缓存（显式登记，生产默认关闭）：单位毫秒，0=关闭，上限 5000。
# 开启后平台侧撤销/登出的本地生效延迟 ≤ 该值，须确认业务可接受吊销延迟后才开启；
# 超过上限按 5000 处理，非法值回退代码缺省 2000。
CENTRAL_SESSION_CACHE_MS=0
