# Dependencies
node_modules/

# Production output
dist/

# Test and tooling output
coverage/
.vite/
*.tsbuildinfo

# 实际环境文件一律忽略；只保留仓库根开发模板和当前 compose.local.yaml 所需模板。
.env
.env.*
.env.local
.env.*.local
!.env.example
# 当前 compose.local.yaml 的运行模板与空 LAN 覆盖文件必须随代码发布。
!docker/.env.local.example
!docker/.env.customer.local.example
!docker/.env.portal.local.example
!docker/.env.lan.disabled

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 本地运行时产生的数据（日志、上传文件等）
data/*

# 本地初始化凭据只允许由启动脚本生成，禁止进入版本库。
docker/.initial-admin-password
data/logs/*.jsonl

# Production backups and monitoring output may contain database records or runtime state.
deploy/production/backups/
deploy/production/monitoring/textfile/

# Never commit the local platform signing key; only the public key may be versioned.
data/keys/jwt-ed25519-private.pem
