# 基础能力平台共享环境变量示例
# 复制为项目根目录 .env 后按实际环境填写；不要提交 .env、私钥或任何真实密码。
# 后端及后续接入系统复用本文件中的共享变量；后端从 backend/ 启动时会回退读取根目录 .env。

# ==================== 通用运行环境 ====================
# 生产环境会强制要求 APP_PUBLIC_BASE_URL 使用 HTTPS；OIDC_ISSUER 留空时复用该地址，显式填写时也必须使用 HTTPS；且 Cookie Secure=true。
APP_ENV=development
APP_NAME=basic-platform
APP_TIMEZONE=Asia/Shanghai

# ==================== 后端 HTTP ====================
APP_HTTP_ADDR=:8080
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# 仅信任实际反向代理的 IP/CIDR；直连开发默认只信任本机回环地址。
APP_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ==================== MySQL（不使用 Redis） ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=basic_platform
MYSQL_USERNAME=basic_platform
MYSQL_PASSWORD=
# 远程 MySQL 自动建库时，指定允许应用账号连接的应用服务器 IP、主机名或经审批的 MySQL 主机模式；本机开发可留空。
MYSQL_APPLICATION_ALLOWED_HOST=
MYSQL_PARAMS="charset=utf8mb4&parseTime=true&loc=UTC"

# ==================== 控制台认证与会话 ====================
# JWT 使用密钥文件路径；请勿将私钥内容写入仓库。
AUTH_JWT_ISSUER=basic-platform
AUTH_JWT_AUDIENCE=basic-platform-console
# 外部系统使用 Client Credentials 获取应用 Bearer Token 时的 JWT audience。
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-integration
# OIDC Discovery、ID Token 和 UserInfo 的公开签发方。留空时自动使用 APP_PUBLIC_BASE_URL；填写时必须是外部系统可访问的绝对基础 URL，不含查询参数或片段。
OIDC_ISSUER=
# 从项目根目录运行 `make -C backend generate-dev-jwt-keys` 可生成对应 Ed25519 PEM 文件。
AUTH_JWT_PRIVATE_KEY_PATH=./data/keys/jwt-ed25519-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./data/keys/jwt-ed25519-public.pem
AUTH_SESSION_COOKIE_NAME=bp_session
# APP_ENV=production 时必须为 true。
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=8h
# OAuth 客户端回调地址默认仅允许 HTTPS，或 localhost/回环地址的 HTTP。
# 仅在受信任内网或遗留部署确有需要时设为 true，以允许注册任意 HTTP 回调地址；生产环境应优先使用 HTTPS。
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=false

# ==================== IAM 敏感字段保护（可选） ====================
# 创建或修改用户时如提交 mobile，必须配置一个 base64 编码的 32 字节 AES-256 密钥。
# 为空时 API 不会保存手机号明文，并会拒绝携带 mobile 的写请求。
IAM_MOBILE_ENCRYPTION_KEY=
# MFA TOTP 密钥必须使用独立的 base64 编码 32 字节 AES-256 密钥；为空时服务拒绝启动，避免写入明文种子。
# 可通过 `openssl rand -base64 32` 生成。
IAM_MFA_ENCRYPTION_KEY=
# 外部身份提供商的 client_secret（DINGTALK_QR 中承载钉钉 SuiteSecret/客户端密钥；app_secret 仅为兼容术语）必须使用与 MFA、外部登录状态不同的 base64 编码 32 字节 AES-256 密钥。
# 不可复用 IAM_MFA_ENCRYPTION_KEY；用于数据库中提供商机密的应用层加密存储。它不是 SuiteSecret/客户端密钥本身。
# 钉钉扫码适配器只有与 IAM_EXTERNAL_LOGIN_STATE_ENCRYPTION_KEY 同时配置时才会注册路由；缺少任一项不影响本地密码和 OIDC 登录。
IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY=
# 外部浏览器登录 state（OIDC 与钉钉扫码）必须使用与 MFA、提供商机密不同的 base64 编码 32 字节 AES-256 密钥。
# 不可复用 IAM_MFA_ENCRYPTION_KEY 或 IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY；用于保护 MySQL 中的一次性登录状态及钉钉扫码服务端载荷，不保存原始 state 或浏览器绑定值。
# 钉钉扫码适配器只有与 IAM_FEDERATED_PROVIDER_SECRET_ENCRYPTION_KEY 同时配置时才会注册路由；缺少任一项不影响本地密码和 OIDC 登录。
IAM_EXTERNAL_LOGIN_STATE_ENCRYPTION_KEY=
# 外部 OIDC 提供商的出站 HTTP 策略。默认仅允许 HTTPS；超时不得超过 1 分钟。
# 允许主机使用逗号分隔的精确 host 或 host:port（例如 login.example.com,login.example.com:8443），不得填写 URL、路径或通配符。
# 列表为空时外部登录保持未启用，不影响本地账号登录或服务启动。
IAM_EXTERNAL_OIDC_HTTP_TIMEOUT=10s
# 钉钉第三方企业应用身份换取接口单次请求超时，必须大于 0 且不超过 1 分钟。
# 钉钉 ISV 内嵌二维码凭据通过受控身份提供商管理接口的 client_id/client_secret 字段配置：client_id=SuiteKey，client_secret=SuiteSecret/客户端密钥；app_key/app_secret 仅为兼容性术语，当前 HTTP JSON 不接受这两个字段。不要在 .env、前端环境变量或日志中保存它们。
# 生产 callback_uri 同样在提供商配置中维护，必须使用已在钉钉开放平台登记的 HTTPS 地址；它不是本环境变量。
IAM_DINGTALK_HTTP_TIMEOUT=10s
IAM_EXTERNAL_OIDC_ALLOW_INSECURE_HTTP=false
IAM_EXTERNAL_OIDC_ALLOWED_HOSTS=
# 仅用于受控初始化首个超级管理员；请使用至少 32 个字符的一次性随机密钥。
# 成功初始化后清空该值并重启服务，接口将返回 404。
IAM_BOOTSTRAP_TOKEN=
# 原生 Linux 部署首次迁移后使用的首个超级管理员一次性配置。仅在管理员尚未初始化时读取；
# 成功后部署脚本会自动清空 IAM_BOOTSTRAP_ADMIN_PASSWORD，保留显示名称和账号供审计参考。
# 非交互部署（--yes）首次初始化必须提供这三个值；交互部署可由脚本安全提示输入。
IAM_BOOTSTRAP_ADMIN_DISPLAY_NAME=
IAM_BOOTSTRAP_ADMIN_ACCOUNT_NAME=
IAM_BOOTSTRAP_ADMIN_PASSWORD=

# ==================== 审计写入与本地文件 ====================
# 平台自身登录、登出等服务端审计使用的应用和环境编码；必须与数据库应用注册表保持一致。
AUDIT_APPLICATION_CODE=platform
AUDIT_ENVIRONMENT_CODE=dev
FILE_STORAGE_ROOT=./data/uploads

# MySQL 异步任务 Worker（审计导出等），不依赖 Redis 或消息队列。
ASYNC_WORKER_ID=basic-platform-worker
ASYNC_WORKER_POLL_INTERVAL=2s
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=./data/logs

# ==================== 可观测性（可选，运行日志/Trace/Metric 不写入 MySQL） ====================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=basic-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
