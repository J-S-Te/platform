# 基础能力平台共享环境变量示例
# 复制为项目根目录 .env 后按实际环境填写；不要提交 .env、私钥或任何真实密码。
# 后端及后续接入系统复用本文件中的共享变量；后端从 backend/ 启动时会回退读取根目录 .env。

# ==================== 通用运行环境 ====================
# 生产环境会强制要求 APP_PUBLIC_BASE_URL 使用 HTTPS；OIDC_ISSUER 留空时复用该地址，显式填写时也必须使用 HTTPS；且 Cookie Secure=true。
APP_ENV=development
APP_NAME=basic-platform
APP_TIMEZONE=Asia/Shanghai

# ==================== 后端 HTTP ====================
APP_HTTP_ADDR=:8080
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# 子系统接入脚本的平台 API 传输保护。仅当脚本直接访问可信局域网 HTTP API 时启用，
# 并填写精确主机白名单；OAuth HTTP 回调由独立配置控制，不受此开关影响。
BASIC_PLATFORM_ALLOW_INSECURE_HTTP_API=false
BASIC_PLATFORM_INSECURE_HTTP_API_ALLOWED_HOSTS=
# 仅信任实际反向代理的 IP/CIDR；直连开发默认只信任本机回环地址。
APP_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ==================== MySQL（不使用 Redis） ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=basic_platform
MYSQL_USERNAME=basic_platform
MYSQL_PASSWORD=
# 远程 MySQL 自动建库时，指定允许应用账号连接的应用服务器 IP、主机名或经审批的 MySQL 主机模式；本机开发可留空。
MYSQL_APPLICATION_ALLOWED_HOST=
MYSQL_PARAMS="charset=utf8mb4&parseTime=true&loc=UTC"

# ==================== 控制台认证与会话 ====================
# JWT 使用密钥文件路径；请勿将私钥内容写入仓库。
AUTH_JWT_ISSUER=basic-platform
AUTH_JWT_AUDIENCE=basic-platform-console
# 外部系统使用 Client Credentials 获取应用 Bearer Token 时的 JWT audience。
AUTH_APPLICATION_JWT_AUDIENCE=basic-platform-integration
# OIDC Discovery、ID Token 和 UserInfo 的公开签发方。留空时自动使用 APP_PUBLIC_BASE_URL；填写时必须是外部系统可访问的绝对基础 URL，不含查询参数或片段。
OIDC_ISSUER=
# 平台与所有子系统共享的授权策略版本哈希。角色目录或权限策略发布后同步更新。
OIDC_ROLE_CONFIG_HASH=REPLACE_WITH_AUTHZ_POLICY_HASH
# 从项目根目录运行 `make -C backend generate-dev-jwt-keys` 可生成对应 Ed25519 PEM 文件。
AUTH_JWT_PRIVATE_KEY_PATH=./data/keys/jwt-ed25519-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./data/keys/jwt-ed25519-public.pem
AUTH_SESSION_COOKIE_NAME=bp_session
# APP_ENV=production 时必须为 true。
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=8h
# OAuth 客户端回调地址默认仅允许 HTTPS，或 localhost/回环地址的 HTTP。
# 仅在受信任内网或遗留部署确有需要时设为 true，以允许注册任意 HTTP 回调地址；生产环境应优先使用 HTTPS。
AUTH_OAUTH_CLIENT_ALLOW_INSECURE_HTTP_REDIRECT_URIS=false

# ==================== 可选 Keycloak 认证层 ====================
# 仅使用 `docker compose --profile keycloak up -d` 时读取；Keycloak 使用独立 MySQL 数据卷。
# 真实密码只放在未提交的 .env、CI/CD Secret 或密钥保管处，不要写入此示例文件。
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=2859332139af0f0de35282d072e6f00f11fb9dd2fcb7f00db7ae559664a2ac6f
KEYCLOAK_DB_ROOT_PASSWORD=93185806ac3d0da1132b438a1836f5425c405917cff88fbbc20ad7b7b9d3f857
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=8ef99f7e79910a7e237cbcdd68f22975af4deacea8632d5b49f6b0e22b4f71b1
# 必须与反向代理实际发布的地址完全一致；正式环境使用 HTTPS 域名。
KEYCLOAK_PUBLIC_URL=http://localhost:18090
KEYCLOAK_HTTP_PORT=18090
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=basic-platform
# 创建平台 Broker Client 并完成 Claims 映射前保持 false。
KEYCLOAK_MANAGEMENT_ENABLED=false
KEYCLOAK_PLATFORM_CLIENT_ID=
KEYCLOAK_PLATFORM_CLIENT_SECRET=

# ==================== 子系统接入自动化（可选） ====================
# 页面接入与角色目录同步默认不需要本地 Docker 自动化；需要自动编排时再开启。
SUBSYSTEM_ONBOARDING_AUTOMATION_ENABLED=false
SUBSYSTEM_ONBOARDING_MODE=local
SUBSYSTEM_ONBOARDING_TIMEOUT=15m
SUBSYSTEM_PROJECTS_ROOT=
SUBSYSTEM_GATEWAY_SCRIPT_PATH=
SUBSYSTEM_GATEWAY_INCLUDE_PATH=
SUBSYSTEM_PROVISIONING_SOCKET_PATH=/run/basic-platform-provisioner/provisioner.sock
SUBSYSTEM_PRODUCTION_DEPLOY_ROOT=
SUBSYSTEM_PRODUCTION_RUNTIME_ENV_PATH=
SUBSYSTEM_PRODUCTION_RELEASE_ENV_PATH=
SUBSYSTEM_PRODUCTION_COMPOSE_FILE=
SUBSYSTEM_PRODUCTION_ALLOWED_TENANT_ID=
SUBSYSTEM_PRODUCTION_PROFILES_DIR=
SUBSYSTEM_PLATFORM_COMPOSE_PROJECT=basic-platform-local
SUBSYSTEM_PLATFORM_FRONTEND_SERVICE=frontend
SUBSYSTEM_PLATFORM_DOCKER_NETWORK=basic-platform-local_default
SUBSYSTEM_DOCKER_BINARY=docker
SUBSYSTEM_INITIAL_ADMIN_ROLES_FROM_MANIFEST=false

# ==================== IAM 敏感字段保护（可选） ====================
# 创建或修改用户时如提交 mobile，必须配置一个 base64 编码的 32 字节 AES-256 密钥。
# 为空时 API 不会保存手机号明文，并会拒绝携带 mobile 的写请求。
IAM_MOBILE_ENCRYPTION_KEY=BrhmcmhnPe+GW5Hy22huIEFTso5Naxss8XiT84NUuvY=
# 仅用于受控初始化首个超级管理员；请使用至少 32 个字符的一次性随机密钥。
# 成功初始化后清空该值并重启服务，接口将返回 404。
IAM_BOOTSTRAP_TOKEN=32cf75e1704074a547b2d4a496fb78ba3f4f999f12ae7aedb867c3cf1cdcd68a
# 原生 Linux 部署首次迁移后使用的首个超级管理员一次性配置。仅在管理员尚未初始化时读取；
# 成功后部署脚本会自动清空 IAM_BOOTSTRAP_ADMIN_PASSWORD，保留显示名称和账号供审计参考。
# 非交互部署（--yes）首次初始化必须提供这三个值；交互部署可由脚本安全提示输入。
IAM_BOOTSTRAP_ADMIN_DISPLAY_NAME=
IAM_BOOTSTRAP_ADMIN_ACCOUNT_NAME=
IAM_BOOTSTRAP_ADMIN_PASSWORD=

# ==================== 审计写入与本地文件 ====================
# 平台自身登录、登出等服务端审计使用的应用和环境编码；必须与数据库应用注册表保持一致。
AUDIT_APPLICATION_CODE=platform
AUDIT_ENVIRONMENT_CODE=dev
FILE_STORAGE_ROOT=./data/uploads

# MySQL 异步任务 Worker（审计导出等），不依赖 Redis 或消息队列。
ASYNC_WORKER_ID=basic-platform-worker
ASYNC_WORKER_POLL_INTERVAL=2s
ASYNC_WORKER_STALE_LOCK_TIMEOUT=5m
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=./data/logs
